<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ── Commission Lines: salesperson sees only their own ──── -->
        <record id="asc_line_salesperson_rule" model="ir.rule">
            <field name="name">Commission Lines: Own Records Only (Salesperson)</field>
            <field name="model_id" ref="model_asc_commission_line"/>
            <field name="domain_force">[('salesperson_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_asc_salesperson'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- ── Managers see all in their company ──────────────────── -->
        <record id="asc_line_manager_rule" model="ir.rule">
            <field name="name">Commission Lines: Company Scope (Manager)</field>
            <field name="model_id" ref="model_asc_commission_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_asc_manager'))]"/>
        </record>

        <!-- ── Targets: salesperson sees only their own ───────────── -->
        <record id="asc_target_salesperson_rule" model="ir.rule">
            <field name="name">Targets: Own Records Only (Salesperson)</field>
            <field name="model_id" ref="model_asc_target"/>
            <field name="domain_force">[('salesperson_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_asc_salesperson'))]"/>
        </record>

        <!-- ── Plans: company isolation ───────────────────────────── -->
        <record id="asc_plan_company_rule" model="ir.rule">
            <field name="name">Commission Plans: Company Isolation</field>
            <field name="model_id" ref="model_asc_commission_plan"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_asc_salesperson'))]"/>
        </record>

        <!-- ── Settlements: company isolation ────────────────────── -->
        <record id="asc_settlement_company_rule" model="ir.rule">
            <field name="name">Settlements: Company Isolation</field>
            <field name="model_id" ref="model_asc_commission_settlement"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_asc_salesperson'))]"/>
        </record>

        <!-- ── Snapshots: salesperson sees their own ─────────────── -->
        <record id="asc_snapshot_salesperson_rule" model="ir.rule">
            <field name="name">Snapshots: Own or Company (Salesperson)</field>
            <field name="model_id" ref="model_asc_dashboard_snapshot"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('user_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('group_asc_salesperson'))]"/>
        </record>

    </data>
</odoo>
