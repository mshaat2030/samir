<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ── Category ────────────────────────────────────────── -->
        <record id="module_category_asc" model="ir.module.category">
            <field name="name">Advanced Sales Commission</field>
            <field name="sequence">100</field>
        </record>

        <!-- ── Privilege ───────────────────────────────────────── -->
        <record id="res_groups_privilege_asc" model="res.groups.privilege">
            <field name="name">Advanced Sales Commission</field>
            <field name="category_id" ref="module_category_asc"/>
        </record>

        <!-- ── Groups ─────────────────────────────────────────── -->
        <record id="group_asc_salesperson" model="res.groups">
            <field name="name">Salesperson</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_asc"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_asc_manager" model="res.groups">
            <field name="name">Commission Manager</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_asc"/>
            <field name="implied_ids" eval="[(4, ref('group_asc_salesperson'))]"/>
        </record>

        <record id="group_asc_finance" model="res.groups">
            <field name="name">Finance / Settlement</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="res_groups_privilege_asc"/>
            <field name="implied_ids" eval="[(4, ref('group_asc_manager'))]"/>
        </record>

        <record id="group_asc_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="sequence">40</field>
            <field name="privilege_id" ref="res_groups_privilege_asc"/>
            <field name="implied_ids" eval="[(4, ref('group_asc_finance'))]"/>
        </record>

        <!-- Grant full ASC access to Odoo Technical Administrators -->
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_asc_admin'))]"/>
        </record>
    </data>
</odoo>
