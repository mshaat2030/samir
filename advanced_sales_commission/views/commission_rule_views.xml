<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_asc_rule_list" model="ir.ui.view">
        <field name="name">asc.commission.rule.list</field>
        <field name="model">asc.commission.rule</field>
        <field name="arch" type="xml">
            <list string="Commission Rules" editable="top">
                <field name="sequence" widget="handle"/>
                <field name="priority"/>
                <field name="name"/>
                <field name="plan_id"/>
                <field name="rule_type"/>
                <field name="rate"/>
                <field name="fixed_amount" optional="hide"/>
                <field name="is_exclusive"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_asc_rule_form" model="ir.ui.view">
        <field name="name">asc.commission.rule.form</field>
        <field name="model">asc.commission.rule</field>
        <field name="arch" type="xml">
            <form string="Commission Rule">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="plan_id"/>
                            <field name="rule_type"/>
                            <field name="priority"/>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="is_exclusive"/>
                            <field name="stack_with_plan"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Rate" invisible="rule_type not in ['fixed','percentage','clawback']">
                            <group>
                                <field name="rate" invisible="rule_type == 'fixed'"/>
                                <field name="rate_on" invisible="rule_type != 'percentage'"/>
                                <field name="fixed_amount" invisible="rule_type not in ['fixed','bonus']"/>
                                <field name="min_amount"/>
                                <field name="max_amount"/>
                                <field name="apply_cap"/>
                            </group>
                        </page>
                        <page string="Tiers" invisible="rule_type != 'tiered'">
                            <field name="tier_ids">
                                <list editable="bottom">
                                    <field name="amount_from"/>
                                    <field name="amount_to"/>
                                    <field name="tier_method"/>
                                    <field name="rate"/>
                                    <field name="fixed_amount"/>
                                </list>
                            </field>
                        </page>
                        <page string="Bonus" invisible="rule_type != 'bonus'">
                            <group>
                                <field name="bonus_trigger"/>
                                <field name="bonus_threshold"/>
                                <field name="bonus_type"/>
                                <field name="bonus_value"/>
                            </group>
                        </page>
                        <page string="Filters">
                            <group>
                                <field name="product_ids" widget="many2many_tags"/>
                                <field name="product_category_ids" widget="many2many_tags"/>
                                <field name="customer_tag_ids" widget="many2many_tags"/>
                                <field name="pricelist_ids" widget="many2many_tags"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_asc_commission_rule" model="ir.actions.act_window">
        <field name="name">Commission Rules</field>
        <field name="res_model">asc.commission.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
