<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Client Action for OWL Dashboard -->
    <record id="action_asc_dashboard" model="ir.actions.client">
        <field name="name">Commission Dashboard</field>
        <field name="tag">asc_dashboard</field>
    </record>

    <!-- Dashboard Snapshot list (admin) -->
    <record id="view_asc_snapshot_list" model="ir.ui.view">
        <field name="name">asc.dashboard.snapshot.list</field>
        <field name="model">asc.dashboard.snapshot</field>
        <field name="arch" type="xml">
            <list string="Dashboard Snapshots">
                <field name="snapshot_date"/>
                <field name="snapshot_type"/>
                <field name="role"/>
                <field name="total_commission"/>
                <field name="total_revenue"/>
                <field name="commission_count"/>
                <field name="pending_approval"/>
                <field name="achievement_pct"/>
                <field name="top_earner"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="action_asc_snapshot" model="ir.actions.act_window">
        <field name="name">Dashboard Snapshots</field>
        <field name="res_model">asc.dashboard.snapshot</field>
        <field name="view_mode">list</field>
        <field name="group_ids" eval="[(4, ref('group_asc_admin'))]"/>
    </record>
</odoo>
