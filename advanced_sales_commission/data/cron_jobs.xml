<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Auto-Calculate: runs daily at 02:00 -->
        <record id="cron_asc_auto_calculate" model="ir.cron">
            <field name="name">ASC: Auto-Calculate Commissions</field>
            <field name="model_id" ref="model_asc_commission_line"/>
            <field name="state">code</field>
            <field name="code">model.env['asc.commission.engine'].batch_recalculate()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
            <field name="priority">10</field>
        </record>

        <!-- Monthly Settlement: runs on 1st of each month -->
        <record id="cron_asc_settlement" model="ir.cron">
            <field name="name">ASC: Generate Monthly Settlements</field>
            <field name="model_id" ref="model_asc_commission_settlement"/>
            <field name="state">code</field>
            <field name="code">
import datetime
today = datetime.date.today()
# Generate settlement for previous month
first_of_month = today.replace(day=1)
prev_month = (first_of_month - datetime.timedelta(days=1))
model.env['asc.settlement.engine'].generate_monthly_settlement(
    month=prev_month.month, year=prev_month.year
)
            </field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>

        <!-- Dashboard Snapshot: runs daily -->
        <record id="cron_asc_dashboard_snapshot" model="ir.cron">
            <field name="name">ASC: Build Dashboard Snapshots</field>
            <field name="model_id" ref="model_asc_dashboard_snapshot"/>
            <field name="state">code</field>
            <field name="code">
for role in ['salesperson', 'manager', 'finance', 'executive']:
    model.env['asc.dashboard.snapshot'].build_snapshot(role=role, snapshot_type='daily')
            </field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>

        <!-- Notification: pending approvals reminder -->
        <record id="cron_asc_pending_notify" model="ir.cron">
            <field name="name">ASC: Notify Pending Approvals</field>
            <field name="model_id" ref="model_asc_commission_line"/>
            <field name="state">code</field>
            <field name="code">
pending = model.env['asc.commission.line'].search([
    ('state', '=', 'submitted'),
    ('is_simulation', '=', False),
])
if pending:
    managers = model.env.ref('advanced_sales_commission.group_asc_manager').users
    for mgr in managers:
        model.env['mail.activity'].create({
            'res_model_id': model.env['ir.model']._get('asc.commission.line').id,
            'res_id': pending[0].id,
            'activity_type_id': model.env.ref('mail.mail_activity_data_todo').id,
            'user_id': mgr.id,
            'summary': f'{len(pending)} commission line(s) awaiting your approval.',
        })
            </field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>
