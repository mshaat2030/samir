            <field name="code">asc.commission.settlement</field>
            <field name="prefix">CS</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_bonus" model="ir.sequence">
            <field name="name">Commission Bonus</field>
            <field name="code">asc.bonus</field>
