<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Settlement Submitted Notification -->
        <record id="email_template_settlement_submitted" model="mail.template">
            <field name="name">Commission Settlement: Submitted</field>
            <field name="model_id" ref="model_commission_settlement"/>
            <field name="subject">Commission Settlement {{ object.name }} submitted for approval</field>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
    <h2 style="color: #875A7B;">Commission Settlement Submitted</h2>
    <p>Hello,</p>
    <p>A commission settlement has been submitted for your approval:</p>
    <table style="width: 100%; border-collapse: collapse;">
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Reference:</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.name }}</td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Employee:</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.employee_id.name }}</td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Period:</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.period_id.name }}</td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Net Commission:</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">
                {{ '%.2f' | format(object.net_commission) }} {{ object.currency_id.symbol }}
            </td>
        </tr>
    </table>
    <p><a href="{{ object.get_base_url() }}/web#model=commission.settlement&amp;id={{ object.id }}"
        style="background-color: #875A7B; color: white; padding: 10px 20px; text-decoration: none; border-radius: 4px;">
        Review Settlement
    </a></p>
</div>
            ]]></field>
            <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- Settlement Paid Notification -->
        <record id="email_template_settlement_paid" model="mail.template">
            <field name="name">Commission Settlement: Paid</field>
            <field name="model_id" ref="model_commission_settlement"/>
            <field name="subject">Your commission settlement {{ object.name }} has been paid</field>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
    <h2 style="color: #28a745;">Commission Payment Processed</h2>
    <p>Dear {{ object.employee_id.name }},</p>
    <p>Your commission for period <strong>{{ object.period_id.name }}</strong> has been processed.</p>
    <table style="width: 100%; border-collapse: collapse;">
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Settlement Ref:</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.name }}</td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Gross Commission:</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">
                {{ '%.2f' | format(object.gross_commission) }} {{ object.currency_id.symbol }}
            </td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Net Payable:</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd; font-weight: bold; color: #28a745;">
                {{ '%.2f' | format(object.net_commission) }} {{ object.currency_id.symbol }}
            </td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Payment Method:</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.settlement_method }}</td>
        </tr>
    </table>
</div>
            ]]></field>
            <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- Dispute Created Notification -->
        <record id="email_template_dispute_created" model="mail.template">
            <field name="name">Commission Dispute: Created</field>
            <field name="model_id" ref="model_commission_dispute"/>
            <field name="subject">New Commission Dispute: {{ object.name }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
    <h2 style="color: #dc3545;">Commission Dispute Raised</h2>
    <p>A new commission dispute has been raised:</p>
    <table style="width: 100%; border-collapse: collapse;">
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Reference:</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.name }}</td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Employee:</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.employee_id.name }}</td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Type:</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.dispute_type }}</td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Current Amount:</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">
                {{ '%.2f' | format(object.current_amount) }} {{ object.currency_id.symbol }}
            </td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Claimed Amount:</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">
                {{ '%.2f' | format(object.claimed_amount) }} {{ object.currency_id.symbol }}
            </td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Description:</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.description }}</td>
        </tr>
    </table>
</div>
            ]]></field>
            <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
            <field name="auto_delete" eval="True"/>
        </record>

    </data>
</odoo>
