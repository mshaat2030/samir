<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ═══ Demo Tags ════════════════════════════════════════════════ -->
        <record id="demo_tag_sales" model="commission.tag">
            <field name="name">Sales</field>
            <field name="color">1</field>
        </record>
        <record id="demo_tag_enterprise" model="commission.tag">
            <field name="name">Enterprise</field>
            <field name="color">2</field>
        </record>
        <record id="demo_tag_renewal" model="commission.tag">
            <field name="name">Renewal</field>
            <field name="color">10</field>
        </record>

        <!-- ═══ Demo Commission Plans ════════════════════════════════════ -->

        <!-- Plan 1: Standard Fixed Rate -->
        <record id="demo_plan_standard" model="commission.plan">
            <field name="name">Standard Sales Commission</field>
            <field name="code">CP-STANDARD</field>
            <field name="plan_type">fixed_percent</field>
            <field name="base_metric">invoiced_amount</field>
            <field name="commission_base">pre_tax</field>
            <field name="fixed_rate">5.0</field>
            <field name="trigger_type">invoice_validate</field>
            <field name="settlement_method">payroll</field>
            <field name="date_from" eval="(DateTime.now() - timedelta(days=365)).strftime('%Y-01-01')"/>
            <field name="date_to" eval="(DateTime.now() + timedelta(days=365)).strftime('%Y-12-31')"/>
            <field name="assignment_type">all</field>
            <field name="has_cap">True</field>
            <field name="cap_amount">50000</field>
            <field name="has_clawback">True</field>
            <field name="clawback_days">90</field>
            <field name="clawback_rate">100.0</field>
            <field name="tag_ids" eval="[(4, ref('demo_tag_sales'))]"/>
            <field name="description">&lt;p&gt;Standard 5% commission on all invoiced revenue. Capped at 50,000 per period.&lt;/p&gt;</field>
        </record>

        <!-- Plan 2: Tiered Commission -->
        <record id="demo_plan_tiered" model="commission.plan">
            <field name="name">Tiered Enterprise Plan</field>
            <field name="code">CP-TIERED</field>
            <field name="plan_type">tiered</field>
            <field name="base_metric">invoiced_amount</field>
            <field name="commission_base">pre_tax</field>
            <field name="fixed_rate">3.0</field>
            <field name="trigger_type">invoice_validate</field>
            <field name="settlement_method">payroll</field>
            <field name="date_from" eval="(DateTime.now() - timedelta(days=365)).strftime('%Y-01-01')"/>
            <field name="date_to" eval="(DateTime.now() + timedelta(days=365)).strftime('%Y-12-31')"/>
            <field name="assignment_type">all</field>
            <field name="tag_ids" eval="[(4, ref('demo_tag_enterprise'))]"/>
        </record>

        <!-- Tiered Rules for Plan 2 -->
        <record id="demo_rule_tier1" model="commission.rule">
            <field name="plan_id" ref="demo_plan_tiered"/>
            <field name="name">Tier 1: 0-10K</field>
            <field name="rule_type">tier</field>
            <field name="from_amount">0</field>
            <field name="to_amount">10000</field>
            <field name="rate">3.0</field>
            <field name="priority">10</field>
        </record>
        <record id="demo_rule_tier2" model="commission.rule">
            <field name="plan_id" ref="demo_plan_tiered"/>
            <field name="name">Tier 2: 10K-50K</field>
            <field name="rule_type">tier</field>
            <field name="from_amount">10000</field>
            <field name="to_amount">50000</field>
            <field name="rate">5.0</field>
            <field name="priority">20</field>
        </record>
        <record id="demo_rule_tier3" model="commission.rule">
            <field name="plan_id" ref="demo_plan_tiered"/>
            <field name="name">Tier 3: 50K+</field>
            <field name="rule_type">tier</field>
            <field name="from_amount">50000</field>
            <field name="to_amount">0</field>
            <field name="rate">7.0</field>
            <field name="priority">30</field>
        </record>

        <!-- Plan 3: Formula-Based -->
        <record id="demo_plan_formula" model="commission.plan">
            <field name="name">Revenue + Margin Formula Plan</field>
            <field name="code">CP-FORMULA</field>
            <field name="plan_type">formula</field>
            <field name="base_metric">invoiced_amount</field>
            <field name="commission_base">pre_tax</field>
            <field name="formula">amount * rate / 100 * (1 + margin_percent * 0.5)</field>
            <field name="fixed_rate">4.0</field>
            <field name="trigger_type">invoice_validate</field>
            <field name="settlement_method">payroll</field>
            <field name="date_from" eval="(DateTime.now() - timedelta(days=365)).strftime('%Y-01-01')"/>
            <field name="date_to" eval="(DateTime.now() + timedelta(days=365)).strftime('%Y-12-31')"/>
            <field name="assignment_type">all</field>
        </record>

        <!-- ═══ Demo Periods ══════════════════════════════════════════════ -->
        <record id="demo_period_current" model="commission.period">
            <field name="name" eval="'Current Month - ' + DateTime.now().strftime('%B %Y')"/>
            <field name="period_type">monthly</field>
            <field name="date_from" eval="DateTime.now().replace(day=1).strftime('%Y-%m-%d')"/>
            <field name="date_to" eval="(DateTime.now().replace(day=1) + timedelta(days=32)).replace(day=1) - timedelta(days=1)"/>
            <field name="plan_ids" eval="[(4, ref('demo_plan_standard')), (4, ref('demo_plan_tiered'))]"/>
        </record>

    </data>
</odoo>
