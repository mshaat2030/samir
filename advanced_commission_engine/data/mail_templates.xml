<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Settlement Submitted -->
    <record id="mail_template_settlement_submitted" model="mail.template">
        <field name="name">Commission Settlement: Submitted for Approval</field>
        <field name="model_id" ref="model_commission_settlement"/>
        <field name="subject">Commission Statement {{ object.name }} – Submitted for Approval</field>
        <field name="body_html"><![CDATA[
<p>Dear {{ object.employee_id.name }},</p>
<p>Your commission statement <strong>{{ object.name }}</strong> for period <strong>{{ object.period_id.name }}</strong> has been submitted for approval.</p>
<table style="width:100%; border-collapse:collapse;">
    <tr>
        <td style="padding:8px; border:1px solid #ddd;"><strong>Period</strong></td>
        <td style="padding:8px; border:1px solid #ddd;">{{ object.period_id.name }}</td>
    </tr>
    <tr>
        <td style="padding:8px; border:1px solid #ddd;"><strong>Total Commission</strong></td>
        <td style="padding:8px; border:1px solid #ddd;">{{ object.final_amount }} {{ object.currency_id.symbol }}</td>
    </tr>
    <tr>
        <td style="padding:8px; border:1px solid #ddd;"><strong>Status</strong></td>
        <td style="padding:8px; border:1px solid #ddd;">Pending Approval</td>
    </tr>
</table>
<p>You will be notified once it is approved.</p>
        ]]></field>
        <field name="email_from">{{ (object.company_id.email or '') }}</field>
        <field name="email_to">{{ (object.employee_id.work_email or object.employee_id.user_id.email or '') }}</field>
        <field name="auto_delete">True</field>
    </record>

    <!-- Settlement Approved -->
    <record id="mail_template_settlement_approved" model="mail.template">
        <field name="name">Commission Settlement: Approved</field>
        <field name="model_id" ref="model_commission_settlement"/>
        <field name="subject">Commission Statement {{ object.name }} – Approved ✓</field>
        <field name="body_html"><![CDATA[
<p>Dear {{ object.employee_id.name }},</p>
<p>Your commission statement <strong>{{ object.name }}</strong> has been <strong style="color:green;">approved</strong>.</p>
<table style="width:100%; border-collapse:collapse;">
    <tr>
        <td style="padding:8px; border:1px solid #ddd;"><strong>Period</strong></td>
        <td style="padding:8px; border:1px solid #ddd;">{{ object.period_id.name }}</td>
    </tr>
    <tr>
        <td style="padding:8px; border:1px solid #ddd;"><strong>Gross Commission</strong></td>
        <td style="padding:8px; border:1px solid #ddd;">{{ object.gross_amount }} {{ object.currency_id.symbol }}</td>
    </tr>
    <tr>
        <td style="padding:8px; border:1px solid #ddd;"><strong>Adjustments</strong></td>
        <td style="padding:8px; border:1px solid #ddd;">{{ object.total_adjustment }} {{ object.currency_id.symbol }}</td>
    </tr>
    <tr>
        <td style="padding:8px; border:1px solid #ddd;"><strong>Final Payout</strong></td>
        <td style="padding:8px; border:1px solid #ddd;"><strong>{{ object.final_amount }} {{ object.currency_id.symbol }}</strong></td>
    </tr>
</table>
<p>Your commission will be processed in the next payroll run.</p>
        ]]></field>
        <field name="email_from">{{ (object.company_id.email or '') }}</field>
        <field name="email_to">{{ (object.employee_id.work_email or object.employee_id.user_id.email or '') }}</field>
        <field name="auto_delete">True</field>
    </record>

    <!-- Settlement Paid -->
    <record id="mail_template_settlement_paid" model="mail.template">
        <field name="name">Commission Settlement: Paid</field>
        <field name="model_id" ref="model_commission_settlement"/>
        <field name="subject">Commission Payment Processed – {{ object.name }}</field>
        <field name="body_html"><![CDATA[
<p>Dear {{ object.employee_id.name }},</p>
<p>Your commission payment of <strong>{{ object.final_amount }} {{ object.currency_id.symbol }}</strong> for period <strong>{{ object.period_id.name }}</strong> has been processed.</p>
<p>Statement Reference: <strong>{{ object.name }}</strong></p>
<p>Please check your payslip or bank statement for the credited amount.</p>
        ]]></field>
        <field name="email_from">{{ (object.company_id.email or '') }}</field>
        <field name="email_to">{{ (object.employee_id.work_email or object.employee_id.user_id.email or '') }}</field>
        <field name="auto_delete">True</field>
    </record>

    <!-- Dispute Raised -->
    <record id="mail_template_dispute_raised" model="mail.template">
        <field name="name">Commission Dispute: Raised</field>
        <field name="model_id" ref="model_commission_dispute"/>
        <field name="subject">Commission Dispute {{ object.name }} – Action Required</field>
        <field name="body_html"><![CDATA[
<p>A commission dispute has been raised by <strong>{{ object.employee_id.name }}</strong>.</p>
<table style="width:100%; border-collapse:collapse;">
    <tr>
        <td style="padding:8px; border:1px solid #ddd;"><strong>Settlement</strong></td>
        <td style="padding:8px; border:1px solid #ddd;">{{ object.settlement_id.name }}</td>
    </tr>
    <tr>
        <td style="padding:8px; border:1px solid #ddd;"><strong>Reason</strong></td>
        <td style="padding:8px; border:1px solid #ddd;">{{ object.reason }}</td>
    </tr>
    <tr>
        <td style="padding:8px; border:1px solid #ddd;"><strong>Requested Amount</strong></td>
        <td style="padding:8px; border:1px solid #ddd;">{{ object.requested_amount }} {{ object.settlement_id.currency_id.symbol }}</td>
    </tr>
</table>
<p>Please review and resolve the dispute within the required timeframe.</p>
        ]]></field>
        <field name="auto_delete">True</field>
    </record>

    <!-- Badge Awarded -->
    <record id="mail_template_badge_awarded" model="mail.template">
        <field name="name">Commission Badge: Awarded</field>
        <field name="model_id" ref="model_commission_badge_award"/>
        <field name="subject">🏆 You earned the {{ object.badge_id.name }} badge!</field>
        <field name="body_html"><![CDATA[
<p>Dear {{ object.employee_id.name }},</p>
<p>Congratulations! You have earned the <strong>{{ object.badge_id.name }}</strong> badge!</p>
<p>{{ object.badge_id.description }}</p>
<p>Keep up the excellent work!</p>
        ]]></field>
        <field name="email_from">{{ (object.employee_id.company_id.email or '') }}</field>
        <field name="email_to">{{ (object.employee_id.work_email or object.employee_id.user_id.email or '') }}</field>
        <field name="auto_delete">True</field>
    </record>
</odoo>
