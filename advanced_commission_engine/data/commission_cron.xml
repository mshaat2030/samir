<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="cron_commission_auto_settle" model="ir.cron">
            <field name="name">Commission: Auto-Generate Settlements</field>
            <field name="model_id" ref="advanced_commission_engine.model_commission_settlement_service"/>
            <field name="state">code</field>
            <field name="code">model.auto_generate_monthly()</field>
            <field name="active" eval="True"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).replace(hour=1, minute=0, second=0)"/>
        </record>

        <record id="cron_commission_deferred_release" model="ir.cron">
            <field name="name">Commission: Release Deferred Commissions</field>
            <field name="model_id" ref="advanced_commission_engine.model_commission_settlement_service"/>
            <field name="state">code</field>
            <field name="code">model.compute_deferred_releases()</field>
            <field name="active" eval="True"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).replace(hour=2, minute=0, second=0)"/>
        </record>

        <record id="cron_commission_clawbacks" model="ir.cron">
            <field name="name">Commission: Process Clawbacks</field>
            <field name="model_id" ref="advanced_commission_engine.model_commission_settlement_service"/>
            <field name="state">code</field>
            <field name="code">model.process_clawbacks()</field>
            <field name="active" eval="True"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).replace(hour=3, minute=0, second=0)"/>
        </record>

        <record id="cron_commission_leaderboard" model="ir.cron">
            <field name="name">Commission: Refresh Leaderboard</field>
            <field name="model_id" ref="advanced_commission_engine.model_commission_leaderboard"/>
            <field name="state">code</field>
            <field name="code">model.cron_refresh_all_leaderboards()</field>
            <field name="active" eval="True"/>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(weeks=1)).replace(hour=4, minute=0, second=0)"/>
        </record>

        <record id="cron_commission_period_generate" model="ir.cron">
            <field name="name">Commission: Auto-Generate Next Period</field>
            <field name="model_id" ref="advanced_commission_engine.model_commission_period"/>
            <field name="state">code</field>
            <field name="code">model.cron_auto_generate_periods()</field>
            <field name="active" eval="True"/>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=28)).replace(day=25, hour=0, minute=0, second=0)"/>
        </record>

    </data>
</odoo>
