<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_commission_plan" model="ir.sequence">
            <field name="name">Commission Plan</field>
            <field name="code">commission.plan</field>
            <field name="prefix">CP-%(year)s-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_commission_period" model="ir.sequence">
            <field name="name">Commission Period</field>
            <field name="code">commission.period</field>
            <field name="prefix">PER-%(year)s-</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_commission_settlement" model="ir.sequence">
            <field name="name">Commission Settlement</field>
            <field name="code">commission.settlement</field>
            <field name="prefix">SETL-%(year)s%(month)s-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_commission_adjustment" model="ir.sequence">
            <field name="name">Commission Adjustment</field>
            <field name="code">commission.adjustment</field>
            <field name="prefix">ADJ-%(year)s-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_commission_dispute" model="ir.sequence">
            <field name="name">Commission Dispute</field>
            <field name="code">commission.dispute</field>
            <field name="prefix">DISP-%(year)s-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
