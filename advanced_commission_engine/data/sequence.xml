<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_commission_plan" model="ir.sequence">
        <field name="name">Commission Plan</field>
        <field name="code">commission.plan</field>
        <field name="prefix">PLAN/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_commission_period" model="ir.sequence">
        <field name="name">Commission Period</field>
        <field name="code">commission.period</field>
        <field name="prefix">PER/%(year)s/%(month)s/</field>
        <field name="padding">3</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_commission_settlement" model="ir.sequence">
        <field name="name">Commission Settlement</field>
        <field name="code">commission.settlement</field>
        <field name="prefix">SET/%(year)s/%(month)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_commission_formula" model="ir.sequence">
        <field name="name">Commission Formula</field>
        <field name="code">commission.formula</field>
        <field name="prefix">FORM/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
