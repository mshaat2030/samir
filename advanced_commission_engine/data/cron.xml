<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Auto-create commission periods monthly -->
        <record id="cron_commission_period_auto_create" model="ir.cron">
            <field name="name">Commission: Auto-create Periods</field>
            <field name="model_id" ref="model_commission_period"/>
            <field name="state">code</field>
            <field name="code">model.cron_auto_create_periods()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>

        <!-- Auto-calculate commissions for open periods -->
        <record id="cron_commission_auto_calculate" model="ir.cron">
            <field name="name">Commission: Auto-calculate Commissions</field>
            <field name="model_id" ref="model_commission_settlement"/>
            <field name="state">code</field>
            <field name="code">model.cron_auto_calculate()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>

        <!-- Update leaderboards daily -->
        <record id="cron_commission_leaderboard_update" model="ir.cron">
            <field name="name">Commission: Update Leaderboards</field>
            <field name="model_id" ref="model_commission_leaderboard"/>
            <field name="state">code</field>
            <field name="code">model.cron_refresh_leaderboard()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>

        <!-- Forecast update weekly -->
        <record id="cron_commission_forecast_update" model="ir.cron">
            <field name="name">Commission: Update Forecasts</field>
            <field name="model_id" ref="model_commission_forecast"/>
            <field name="state">code</field>
            <field name="code">model.cron_update_forecasts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>

        <!-- Anomaly detection daily -->
        <record id="cron_commission_anomaly_detection" model="ir.cron">
            <field name="name">Commission: Anomaly Detection</field>
            <field name="model_id" ref="model_commission_settlement"/>
            <field name="state">code</field>
            <field name="code">model.cron_detect_anomalies()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>

        <!-- Lock past periods automatically -->
        <record id="cron_commission_period_lock" model="ir.cron">
            <field name="name">Commission: Auto-lock Past Periods</field>
            <field name="model_id" ref="model_commission_period"/>
            <field name="state">code</field>
            <field name="code">model.cron_auto_lock_periods()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>

        <!-- Clawback check monthly -->
        <record id="cron_commission_clawback_check" model="ir.cron">
            <field name="name">Commission: Clawback Check</field>
            <field name="model_id" ref="model_commission_adjustment"/>
            <field name="state">code</field>
            <field name="code">model.cron_process_clawbacks()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>
