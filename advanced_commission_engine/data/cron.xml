<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Auto-create commission periods -->
    <record id="cron_create_commission_periods" model="ir.cron">
        <field name="name">Commission: Auto-Create Periods</field>
        <field name="model_id" ref="model_commission_period"/>
        <field name="state">code</field>
        <field name="code">model._cron_create_periods()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
    </record>

    <!-- Auto-calculate pending commissions -->
    <record id="cron_calculate_commissions" model="ir.cron">
        <field name="name">Commission: Auto-Calculate Settlements</field>
        <field name="model_id" ref="model_commission_settlement"/>
        <field name="state">code</field>
        <field name="code">model._cron_calculate_settlements()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
    </record>

    <!-- Refresh leaderboards -->
    <record id="cron_refresh_leaderboard" model="ir.cron">
        <field name="name">Commission: Refresh Leaderboards</field>
        <field name="model_id" ref="model_commission_leaderboard"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh_leaderboards()</field>
        <field name="interval_number">6</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
    </record>

    <!-- Anomaly detection -->
    <record id="cron_anomaly_detection" model="ir.cron">
        <field name="name">Commission: Anomaly Detection</field>
        <field name="model_id" ref="model_commission_settlement"/>
        <field name="state">code</field>
        <field name="code">model._cron_detect_anomalies()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
    </record>

    <!-- Update forecasts -->
    <record id="cron_update_forecasts" model="ir.cron">
        <field name="name">Commission: Update Payout Forecasts</field>
        <field name="model_id" ref="model_commission_forecast"/>
        <field name="state">code</field>
        <field name="code">model._cron_update_forecasts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
    </record>

    <!-- Award badges -->
    <record id="cron_award_badges" model="ir.cron">
        <field name="name">Commission: Award Achievement Badges</field>
        <field name="model_id" ref="model_commission_badge"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_and_award_badges()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>
