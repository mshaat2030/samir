<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ═══ Multi-Company Isolation ═══════════════════════════════════ -->

        <record id="commission_plan_company_rule" model="ir.rule">
            <field name="name">Commission Plan: Company Isolation</field>
            <field name="model_id" ref="model_commission_plan"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_commission_user'))]"/>
        </record>

        <record id="commission_period_company_rule" model="ir.rule">
            <field name="name">Commission Period: Company Isolation</field>
            <field name="model_id" ref="model_commission_period"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_commission_user'))]"/>
        </record>

        <record id="commission_settlement_company_rule" model="ir.rule">
            <field name="name">Commission Settlement: Company Isolation</field>
            <field name="model_id" ref="model_commission_settlement"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_commission_manager'))]"/>
        </record>

        <record id="commission_line_company_rule" model="ir.rule">
            <field name="name">Commission Line: Company Isolation</field>
            <field name="model_id" ref="model_commission_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_commission_manager'))]"/>
        </record>

        <!-- ═══ Employee Own-Record Rules ══════════════════════════════════ -->

        <!-- Commission Users can only see their own settlement lines -->
        <record id="commission_line_own_rule" model="ir.rule">
            <field name="name">Commission Line: Own Records Only (User)</field>
            <field name="model_id" ref="model_commission_line"/>
            <field name="domain_force">[
                ('employee_id.user_id', '=', user.id),
                ('company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[(4, ref('group_commission_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Remove restriction for managers (they see all) -->
        <record id="commission_line_manager_rule" model="ir.rule">
            <field name="name">Commission Line: All Records (Manager)</field>
            <field name="model_id" ref="model_commission_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_commission_manager'))]"/>
        </record>

        <!-- Settlement: Users see only their own -->
        <record id="commission_settlement_own_rule" model="ir.rule">
            <field name="name">Commission Settlement: Own Records Only (User)</field>
            <field name="model_id" ref="model_commission_settlement"/>
            <field name="domain_force">[
                ('employee_id.user_id', '=', user.id),
                ('company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[(4, ref('group_commission_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Dispute: Users can only raise/see their own disputes -->
        <record id="commission_dispute_own_rule" model="ir.rule">
            <field name="name">Commission Dispute: Own Records (User)</field>
            <field name="model_id" ref="model_commission_dispute"/>
            <field name="domain_force">[
                ('employee_id.user_id', '=', user.id),
                ('company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[(4, ref('group_commission_user'))]"/>
        </record>

        <record id="commission_dispute_manager_rule" model="ir.rule">
            <field name="name">Commission Dispute: All Records (Manager)</field>
            <field name="model_id" ref="model_commission_dispute"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_commission_manager'))]"/>
        </record>

        <!-- Target: Users see only their own targets -->
        <record id="commission_target_own_rule" model="ir.rule">
            <field name="name">Commission Target: Own Records (User)</field>
            <field name="model_id" ref="model_commission_target"/>
            <field name="domain_force">[
                ('employee_id.user_id', '=', user.id),
                ('company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[(4, ref('group_commission_user'))]"/>
        </record>

        <record id="commission_target_manager_rule" model="ir.rule">
            <field name="name">Commission Target: All Records (Manager)</field>
            <field name="model_id" ref="model_commission_target"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_commission_manager'))]"/>
        </record>

        <!-- Adjustment: Users cannot write adjustments -->
        <record id="commission_adjustment_company_rule" model="ir.rule">
            <field name="name">Commission Adjustment: Company Isolation</field>
            <field name="model_id" ref="model_commission_adjustment"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_commission_manager'))]"/>
        </record>

    </data>
</odoo>
