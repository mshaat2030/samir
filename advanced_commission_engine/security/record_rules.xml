<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================
             MULTI-COMPANY ISOLATION
        ============================================================ -->

        <record id="rule_commission_plan_company" model="ir.rule">
            <field name="name">Commission Plan: Multi-company</field>
            <field name="model_id" ref="model_commission_plan"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_commission_period_company" model="ir.rule">
            <field name="name">Commission Period: Multi-company</field>
            <field name="model_id" ref="model_commission_period"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_commission_settlement_company" model="ir.rule">
            <field name="name">Commission Settlement: Multi-company</field>
            <field name="model_id" ref="model_commission_settlement"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- ============================================================
             OWN-RECORD ACCESS FOR COMMISSION USERS
        ============================================================ -->

        <!-- Users only see their own settlements -->
        <record id="rule_commission_settlement_own" model="ir.rule">
            <field name="name">Commission Settlement: Own records only (User)</field>
            <field name="model_id" ref="model_commission_settlement"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_commission_user'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- Managers see all settlements in their company -->
        <record id="rule_commission_settlement_manager" model="ir.rule">
            <field name="name">Commission Settlement: Company scope (Manager)</field>
            <field name="model_id" ref="model_commission_settlement"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_commission_manager'))]"/>
        </record>

        <!-- Users only see their own commission lines -->
        <record id="rule_commission_line_own" model="ir.rule">
            <field name="name">Commission Line: Own records only (User)</field>
            <field name="model_id" ref="model_commission_line"/>
            <field name="domain_force">[('settlement_id.employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_commission_user'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- Users only see their own targets -->
        <record id="rule_commission_target_own" model="ir.rule">
            <field name="name">Commission Target: Own records only (User)</field>
            <field name="model_id" ref="model_commission_target"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_commission_user'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- Users only see their own KPIs -->
        <record id="rule_commission_kpi_own" model="ir.rule">
            <field name="name">Commission KPI: Own records only (User)</field>
            <field name="model_id" ref="model_commission_kpi"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_commission_user'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- Users only see their own forecasts -->
        <record id="rule_commission_forecast_own" model="ir.rule">
            <field name="name">Commission Forecast: Own records only (User)</field>
            <field name="model_id" ref="model_commission_forecast"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_commission_user'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- Users can create/edit their own disputes -->
        <record id="rule_commission_dispute_own" model="ir.rule">
            <field name="name">Commission Dispute: Own records (User)</field>
            <field name="model_id" ref="model_commission_dispute"/>
            <field name="domain_force">[('settlement_id.employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_commission_user'))]"/>
        </record>

        <!-- ============================================================
             FORMULA SECURITY — Only admin can see formula expressions
        ============================================================ -->

        <record id="rule_commission_formula_admin" model="ir.rule">
            <field name="name">Commission Formula: Admin only</field>
            <field name="model_id" ref="model_commission_formula"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_commission_admin'))]"/>
        </record>

    </data>
</odoo>
