<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ═══ Privilege (replaces category in Odoo 19) ══════════════════ -->
        <record id="res_groups_privilege_commission" model="res.groups.privilege">
            <field name="name">Commission Engine</field>
            <field name="sequence">95</field>
            <field name="category_id" ref="base.module_category_sales_crm"/>
        </record>

        <!-- ═══ Groups ════════════════════════════════════════════════════ -->

        <!-- Commission User: View own commissions and create disputes -->
        <record id="group_commission_user" model="res.groups">
            <field name="name">User</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_commission"/>
            <field name="comment">Can view own commission statements and raise disputes.</field>
        </record>

        <!-- Commission Manager: Full CRUD on plans, settlements, periods -->
        <record id="group_commission_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_commission"/>
            <field name="implied_ids" eval="[(4, ref('group_commission_user'))]"/>
            <field name="comment">Can create and manage commission plans, approve settlements.</field>
        </record>

        <!-- Finance Manager: Approve payments, create journal entries -->
        <record id="group_commission_finance" model="res.groups">
            <field name="name">Finance Manager</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="res_groups_privilege_commission"/>
            <field name="implied_ids" eval="[(4, ref('group_commission_manager'))]"/>
            <field name="comment">Can approve and process commission payments, unlock periods.</field>
        </record>

        <!-- HR Manager: Manage employee assignments, payroll integration -->
        <record id="group_commission_hr" model="res.groups">
            <field name="name">HR Manager</field>
            <field name="sequence">40</field>
            <field name="privilege_id" ref="res_groups_privilege_commission"/>
            <field name="implied_ids" eval="[(4, ref('group_commission_manager'))]"/>
            <field name="comment">Can manage employee commission assignments and payroll integration.</field>
        </record>

        <!-- Executive Viewer: Read-only access to all commission data -->
        <record id="group_commission_executive" model="res.groups">
            <field name="name">Executive Viewer</field>
            <field name="sequence">50</field>
            <field name="privilege_id" ref="res_groups_privilege_commission"/>
            <field name="implied_ids" eval="[(4, ref('group_commission_user'))]"/>
            <field name="comment">Read-only access to all commission data and analytics.</field>
        </record>

    </data>
</odoo>
