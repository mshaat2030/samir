<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="advanced_commission_engine.CommissionKpiCard">
        <div t-att-class="cardClass + (props.onClick ? ' commission-kpi-card-clickable' : '')"
             t-on-click="handleClick">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="flex-grow-1">
                        <div class="text-muted small text-uppercase fw-bold mb-1">
                            <t t-esc="props.title"/>
                        </div>
                        <t t-if="props.loading">
                            <div class="placeholder-glow">
                                <span class="placeholder col-6"/>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="fs-4 fw-bold">
                                <t t-esc="props.value"/>
                            </div>
                            <t t-if="props.subtitle">
                                <div class="text-muted small mt-1">
                                    <t t-esc="props.subtitle"/>
                                </div>
                            </t>
                            <t t-if="props.trend and props.trendValue">
                                <div t-att-class="'small mt-1 ' + trendClass">
                                    <i t-att-class="trendIcon + ' me-1'"/>
                                    <t t-esc="props.trendValue"/>
                                </div>
                            </t>
                        </t>
                    </div>
                    <div class="ms-3">
                        <i t-att-class="iconFullClass"/>
                        <t t-if="props.badge">
                            <span t-att-class="'badge ms-1 ' + (props.badgeClass || 'text-bg-secondary')">
                                <t t-esc="props.badge"/>
                            </span>
                        </t>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
