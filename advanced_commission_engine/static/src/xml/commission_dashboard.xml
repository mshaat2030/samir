<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="advanced_commission_engine.CommissionDashboard">
        <div class="commission-dashboard o_action container-fluid py-3">

            <!-- ═══ Header ════════════════════════════════════════════════ -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="mb-0">
                        <i class="fa fa-trophy text-warning me-2"/>
                        Commission Dashboard
                    </h2>
                    <p class="text-muted mb-0" t-if="state.period">
                        <i class="fa fa-calendar me-1"/>
                        Period: <strong t-esc="state.period.name"/>
                        <span t-att-class="'badge ms-2 ' + (state.period.state === 'locked' ? 'text-bg-success' : 'text-bg-info')">
                            <t t-esc="state.period.state"/>
                        </span>
                    </p>
                </div>
                <div class="d-flex gap-2">
                    <!-- Period selector -->
                    <select class="form-select form-select-sm" style="max-width: 200px"
                        t-on-change="onPeriodChange">
                        <t t-foreach="state.periods" t-as="period">
                            <option t-att-value="period.id"
                                    t-att-selected="period.id === state.selectedPeriodId">
                                <t t-esc="period.name"/>
                            </option>
                        </t>
                    </select>
                    <button class="btn btn-outline-secondary btn-sm" t-on-click="refreshDashboard">
                        <i class="fa fa-refresh"/>
                    </button>
                </div>
            </div>

            <!-- ═══ Quick Actions Bar ═════════════════════════════════════ -->
            <div class="d-flex gap-2 mb-4 flex-wrap">
                <button class="btn btn-primary btn-sm" t-on-click="openSettlementWizard">
                    <i class="fa fa-plus me-1"/> Generate Settlements
                </button>
                <button class="btn btn-outline-primary btn-sm" t-on-click="openSimulationWizard">
                    <i class="fa fa-calculator me-1"/> Quick Simulation
                </button>
                <button class="btn btn-outline-secondary btn-sm" t-on-click="openPlans">
                    <i class="fa fa-cogs me-1"/> Plans
                </button>
                <button class="btn btn-outline-secondary btn-sm" t-on-click="openPeriods">
                    <i class="fa fa-calendar me-1"/> Periods
                </button>
                <button class="btn btn-outline-warning btn-sm" t-on-click="openDisputes"
                    t-if="state.kpis.openDisputes > 0">
                    <i class="fa fa-exclamation-triangle me-1"/>
                    <t t-esc="state.kpis.openDisputes"/> Open Disputes
                </button>
            </div>

            <!-- ═══ Loading State ═════════════════════════════════════════ -->
            <t t-if="state.loading">
                <div class="row g-3 mb-4">
                    <t t-foreach="[1,2,3,4,5,6]" t-as="i">
                        <div class="col-xl-2 col-lg-4 col-md-6">
                            <div class="card">
                                <div class="card-body placeholder-glow">
                                    <span class="placeholder col-8 mb-2 d-block"/>
                                    <span class="placeholder col-6"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </t>

            <!-- ═══ KPI Cards Row ════════════════════════════════════════ -->
            <t t-if="!state.loading">
                <div class="row g-3 mb-4">
                    <div class="col-xl-2 col-lg-4 col-md-6">
                        <CommissionKpiCard
                            title="'Total Commission'"
                            value="formatAmount(state.kpis.totalCommission)"
                            icon="'fa-money'"
                            iconClass="'text-primary'"
                            color="'primary'"
                            onClick.bind="openLines"
                        />
                    </div>
                    <div class="col-xl-2 col-lg-4 col-md-6">
                        <CommissionKpiCard
                            title="'Total Paid'"
                            value="formatAmount(state.kpis.totalPaid)"
                            icon="'fa-check-circle'"
                            iconClass="'text-success'"
                            color="'success'"
                            onClick.bind="openSettlements"
                        />
                    </div>
                    <div class="col-xl-2 col-lg-4 col-md-6">
                        <CommissionKpiCard
                            title="'Pending Payment'"
                            value="formatAmount(state.kpis.totalPending)"
                            icon="'fa-clock-o'"
                            iconClass="'text-warning'"
                            color="'warning'"
                        />
                    </div>
                    <div class="col-xl-2 col-lg-4 col-md-6">
                        <CommissionKpiCard
                            title="'Settlements'"
                            value="state.kpis.settlementsCount"
                            icon="'fa-file-text'"
                            iconClass="'text-info'"
                            color="'info'"
                            onClick.bind="openSettlements"
                        />
                    </div>
                    <div class="col-xl-2 col-lg-4 col-md-6">
                        <CommissionKpiCard
                            title="'Avg Achievement'"
                            value="state.kpis.achievementRate + '%'"
                            icon="'fa-bullseye'"
                            iconClass="'text-success'"
                            color="'success'"
                        />
                    </div>
                    <div class="col-xl-2 col-lg-4 col-md-6">
                        <CommissionKpiCard
                            title="'Open Disputes'"
                            value="state.kpis.openDisputes"
                            icon="'fa-exclamation-circle'"
                            iconClass="'text-danger'"
                            color="'danger'"
                            onClick.bind="openDisputes"
                        />
                    </div>
                </div>

                <!-- ═══ Period Progress Bar ═══════════════════════════════ -->
                <div class="card mb-4">
                    <div class="card-body py-2">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <small class="text-muted">Period Progress</small>
                            <small class="text-muted">
                                <t t-esc="state.periodProgress"/>%
                            </small>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar bg-primary"
                                t-att-style="'width: ' + state.periodProgress + '%'"/>
                        </div>
                    </div>
                </div>

                <!-- ═══ Main Content Row ══════════════════════════════════ -->
                <div class="row g-3">

                    <!-- ═══ Top Performers (Leaderboard) ════════════════ -->
                    <div class="col-lg-5">
                        <div class="card h-100">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h6 class="mb-0">
                                    <i class="fa fa-trophy text-warning me-2"/>
                                    Top Performers
                                </h6>
                                <button class="btn btn-link btn-sm p-0" t-on-click="openLeaderboard">
                                    View all <i class="fa fa-arrow-right ms-1"/>
                                </button>
                            </div>
                            <div class="card-body p-0">
                                <t t-if="state.topPerformers.length === 0">
                                    <div class="text-center text-muted py-4">
                                        <i class="fa fa-trophy fa-3x mb-2 d-block"/>
                                        No data for this period
                                    </div>
                                </t>
                                <div class="list-group list-group-flush">
                                    <t t-foreach="state.topPerformers" t-as="performer">
                                        <div class="list-group-item px-3 py-2">
                                            <div class="d-flex align-items-center">
                                                <div class="commission-rank-badge me-3"
                                                    t-att-class="performer.rank <= 3 ? 'text-warning' : 'text-muted'">
                                                    <strong t-esc="'#' + performer.rank"/>
                                                </div>
                                                <img t-att-src="performer.employee_image"
                                                    class="rounded-circle me-2"
                                                    width="32" height="32"
                                                    t-att-alt="performer.employee_name"/>
                                                <div class="flex-grow-1">
                                                    <div class="fw-semibold small">
                                                        <t t-esc="performer.employee_name"/>
                                                        <t t-if="performer.is_top_performer">
                                                            <i class="fa fa-star text-warning ms-1"/>
                                                        </t>
                                                    </div>
                                                    <div class="text-muted" style="font-size: 0.75rem;">
                                                        <t t-esc="performer.achievement_percent.toFixed(1)"/>% achievement
                                                    </div>
                                                </div>
                                                <div class="text-end">
                                                    <div class="fw-bold text-success small">
                                                        <t t-esc="performer.currency_symbol"/>
                                                        <t t-esc="formatAmount(performer.commission_amount)"/>
                                                    </div>
                                                    <i t-att-class="'fa fa-sm ' + getTrendIcon(performer.rank_trend)"/>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ═══ Recent Settlements ═══════════════════════════ -->
                    <div class="col-lg-7">
                        <div class="card h-100">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h6 class="mb-0">
                                    <i class="fa fa-file-text-o me-2 text-info"/>
                                    Recent Settlements
                                </h6>
                                <button class="btn btn-link btn-sm p-0" t-on-click="openSettlements">
                                    View all <i class="fa fa-arrow-right ms-1"/>
                                </button>
                            </div>
                            <div class="card-body p-0">
                                <t t-if="state.recentSettlements.length === 0">
                                    <div class="text-center text-muted py-4">
                                        <i class="fa fa-file-text fa-3x mb-2 d-block"/>
                                        No settlements in this period
                                    </div>
                                </t>
                                <table class="table table-hover table-sm mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Reference</th>
                                            <th>Employee</th>
                                            <th class="text-end">Amount</th>
                                            <th>Method</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="state.recentSettlements" t-as="s">
                                            <tr>
                                                <td class="small"><t t-esc="s.name"/></td>
                                                <td class="small">
                                                    <t t-esc="s.employee_id[1]"/>
                                                </td>
                                                <td class="text-end fw-bold small">
                                                    <t t-esc="formatAmount(s.net_commission)"/>
                                                </td>
                                                <td class="small">
                                                    <span class="badge text-bg-secondary">
                                                        <t t-esc="s.settlement_method"/>
                                                    </span>
                                                </td>
                                                <td>
                                                    <span t-att-class="'badge ' + getStateClass(s.state)">
                                                        <t t-esc="s.state"/>
                                                    </span>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- ═══ Chart Row ════════════════════════════════════════ -->
                <div class="row g-3 mt-0" t-if="state.chartData.length > 0">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h6 class="mb-0">
                                    <i class="fa fa-bar-chart me-2 text-primary"/>
                                    Commission Trend (12 Months)
                                </h6>
                            </div>
                            <div class="card-body">
                                <div class="commission-chart-container">
                                    <div class="d-flex align-items-end gap-1" style="height: 120px;">
                                        <t t-set="maxVal" t-value="Math.max(...state.chartData.map(d => d.value))"/>
                                        <t t-foreach="state.chartData" t-as="bar">
                                            <div class="flex-grow-1 d-flex flex-column align-items-center">
                                                <div class="commission-chart-bar bg-primary rounded-top"
                                                    t-att-style="'height: ' + (maxVal > 0 ? Math.max(4, Math.round((bar.value / maxVal) * 100)) : 4) + 'px; width: 100%; min-height: 4px; transition: height 0.3s;'"
                                                    t-att-title="bar.label + ': ' + formatAmount(bar.value)">
                                                </div>
                                                <div class="text-muted mt-1" style="font-size: 0.6rem;">
                                                    <t t-esc="bar.label ? bar.label.substring(0, 3) : ''"/>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </t>
        </div>
    </t>

</templates>
