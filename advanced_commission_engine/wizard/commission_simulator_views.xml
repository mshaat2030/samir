<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wizard_commission_simulator_form" model="ir.ui.view">
        <field name="name">wizard.commission.simulator.form</field>
        <field name="model">wizard.commission.simulator</field>
        <field name="arch" type="xml">
            <form string="Commission Simulator">
                <sheet>
                    <div class="oe_title">
                        <h1>What-If Simulator</h1>
                    </div>
                    <group>
                        <group string="Setup">
                            <field name="plan_id" options="{'no_create': True}"/>
                            <field name="employee_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Parameters">
                            <field name="base_amount"/>
                            <field name="margin_pct"/>
                            <field name="achievement_pct"/>
                            <field name="kpi_score"/>
                        </group>
                    </group>
                    <div attrs="{'invisible': [('has_result', '=', False)]}">
                        <separator string="Results"/>
                        <group>
                            <group>
                                <field name="result_commission" class="o_field_monetary"/>
                            </group>
                        </group>
                        <field name="result_breakdown" widget="text" readonly="1"/>
                    </div>
                </sheet>
                <footer>
                    <button name="action_simulate" type="object" string="Simulate" class="btn-primary"/>
                    <button name="action_save_simulation" type="object" string="Save Simulation"
                            class="btn-secondary" attrs="{'invisible': [('has_result', '=', False)]}"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wizard_commission_simulator" model="ir.actions.act_window">
        <field name="name">Commission Simulator</field>
        <field name="res_model">wizard.commission.simulator</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
