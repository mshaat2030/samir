<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wizard_commission_simulator_form" model="ir.ui.view">
        <field name="name">wizard.commission.simulator.form</field>
        <field name="model">wizard.commission.simulator</field>
        <field name="arch" type="xml">
            <form string="Commission Simulator">
                <group>
                    <group string="Plan &amp; Employee">
                        <field name="plan_id"/>
                        <field name="employee_id"/>
                        <field name="period_id"/>
                        <field name="use_actual_data"/>
                    </group>
                    <group string="Scenario" invisible="use_actual_data">
                        <field name="base_amount"/>
                        <field name="margin_pct"/>
                        <field name="kpi_score"/>
                    </group>
                </group>
                <group string="Result" invisible="not result_html">
                    <field name="total_commission" readonly="1" class="text-success fw-bold"/>
                    <field name="result_html" readonly="1" widget="html"/>
                </group>
                <footer>
                    <button name="action_simulate" string="Run Simulation"
                            type="object" class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wizard_commission_simulator" model="ir.actions.act_window">
        <field name="name">Commission Simulator</field>
        <field name="res_model">wizard.commission.simulator</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
