<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wizard_rollback_commission_form" model="ir.ui.view">
        <field name="name">wizard.rollback.commission.form</field>
        <field name="model">wizard.rollback.commission</field>
        <field name="arch" type="xml">
            <form string="Rollback Commission Settlement">
                <group>
                    <field name="settlement_id"/>
                    <field name="rollback_type"/>
                    <field name="reason"/>
                    <field name="clawback_amount"
                           invisible="rollback_type != 'clawback'"/>
                    <field name="new_settlement_id"
                           invisible="rollback_type != 'clawback'"/>
                </group>
                <footer>
                    <button name="action_rollback" string="Execute Rollback"
                            type="object" class="btn-danger"
                            confirm="This action cannot be easily undone. Continue?"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wizard_rollback_commission" model="ir.actions.act_window">
        <field name="name">Rollback Settlement</field>
        <field name="res_model">wizard.rollback.commission</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
