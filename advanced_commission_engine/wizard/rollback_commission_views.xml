<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wizard_rollback_commission_form" model="ir.ui.view">
        <field name="name">wizard.commission.rollback.form</field>
        <field name="model">wizard.commission.rollback</field>
        <field name="arch" type="xml">
            <form string="Rollback Paid Settlement">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        <strong>Warning:</strong> Rolling back a paid settlement will create a clawback adjustment
                        and reset the settlement to Calculated state. This action is logged and cannot be undone easily.
                    </div>
                    <group>
                        <group string="Settlement">
                            <field name="settlement_id" options="{'no_create': True}"/>
                            <field name="paid_amount"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Rollback Reason">
                            <field name="rollback_reason"/>
                            <field name="create_accounting_reversal"/>
                            <field name="create_payroll_reversal"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" placeholder="Provide detailed justification for this rollback..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_rollback" type="object" string="Confirm Rollback"
                            class="btn-danger" confirm="Are you sure you want to roll back this paid settlement?"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wizard_rollback_commission" model="ir.actions.act_window">
        <field name="name">Rollback Commission</field>
        <field name="res_model">wizard.commission.rollback</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
