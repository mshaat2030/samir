<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wizard_generate_settlement_form" model="ir.ui.view">
        <field name="name">wizard.generate.settlement.form</field>
        <field name="model">wizard.generate.settlement</field>
        <field name="arch" type="xml">
            <form string="Generate Commission Settlements">
                <group>
                    <group string="Selection">
                        <field name="period_id"/>
                        <field name="plan_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="employee_ids" widget="many2many_tags"/>
                    </group>
                    <group string="Options">
                        <field name="only_new"/>
                        <field name="auto_calculate"/>
                    </group>
                </group>
                <group string="Result" invisible="not result_summary">
                    <field name="result_summary" readonly="1" widget="text"/>
                </group>
                <footer>
                    <button name="action_generate" string="Generate Settlements"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wizard_generate_settlement" model="ir.actions.act_window">
        <field name="name">Generate Settlements</field>
        <field name="res_model">wizard.generate.settlement</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
