<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wizard_recalculate_commission_form" model="ir.ui.view">
        <field name="name">wizard.recalculate.commission.form</field>
        <field name="model">wizard.recalculate.commission</field>
        <field name="arch" type="xml">
            <form string="Recalculate Commissions">
                <group>
                    <group string="Scope">
                        <field name="period_id"/>
                        <field name="plan_id"/>
                        <field name="employee_ids" widget="many2many_tags"/>
                    </group>
                    <group string="Options">
                        <field name="include_states"/>
                        <field name="reason"/>
                    </group>
                </group>
                <group string="Result" invisible="not result_summary">
                    <field name="result_summary" readonly="1" widget="text"/>
                </group>
                <footer>
                    <button name="action_recalculate" string="Recalculate"
                            type="object" class="btn-warning"
                            confirm="This will overwrite existing commission lines. Continue?"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wizard_recalculate_commission" model="ir.actions.act_window">
        <field name="name">Recalculate Commissions</field>
        <field name="res_model">wizard.recalculate.commission</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
