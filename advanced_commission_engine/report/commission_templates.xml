<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Commission Statement PDF Template -->
    <template id="report_commission_statement">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <!-- Header -->
                        <div class="row mb-4">
                            <div class="col-6">
                                <h2>Commission Statement</h2>
                                <p class="text-muted">Reference: <strong><t t-esc="doc.name"/></strong></p>
                            </div>
                            <div class="col-6 text-right">
                                <span t-attf-class="badge badge-{{ 'success' if doc.state == 'paid' else 'warning' if doc.state in ('submitted','approved') else 'secondary' }} float-right">
                                    <t t-esc="dict(doc._fields['state'].selection).get(doc.state, doc.state)"/>
                                </span>
                            </div>
                        </div>

                        <!-- Employee Details -->
                        <div class="row mb-4">
                            <div class="col-6">
                                <table class="table table-sm table-borderless">
                                    <tr><th>Employee:</th><td><t t-esc="doc.employee_id.name"/></td></tr>
                                    <tr><th>Period:</th><td><t t-esc="doc.period_id.name"/></td></tr>
                                    <tr><th>Plan:</th><td><t t-esc="doc.plan_id.name"/></td></tr>
                                </table>
                            </div>
                            <div class="col-6">
                                <table class="table table-sm table-borderless">
                                    <tr><th>Company:</th><td><t t-esc="doc.company_id.name"/></td></tr>
                                    <tr t-if="doc.payment_date"><th>Payment Date:</th><td><t t-esc="doc.payment_date"/></td></tr>
                                    <tr t-if="doc.approved_by_id"><th>Approved By:</th><td><t t-esc="doc.approved_by_id.name"/></td></tr>
                                </table>
                            </div>
                        </div>

                        <!-- Commission Lines -->
                        <h4>Commission Details</h4>
                        <table class="table table-sm table-striped">
                            <thead class="thead-dark">
                                <tr>
                                    <th>Date</th>
                                    <th>Source</th>
                                    <th>Description</th>
                                    <th>Customer</th>
                                    <th class="text-right">Base Amount</th>
                                    <th class="text-right">Rate</th>
                                    <th class="text-right">Commission</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.line_ids.filtered(lambda l: not l.is_excluded)" t-as="line">
                                    <tr>
                                        <td><t t-esc="line.date"/></td>
                                        <td><t t-esc="line.source_type"/></td>
                                        <td><t t-esc="line.description or ''"/></td>
                                        <td><t t-esc="line.partner_id.name if line.partner_id else ''"/></td>
                                        <td class="text-right">
                                            <t t-esc="line.base_amount" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                        </td>
                                        <td class="text-right"><t t-esc="'%.2f%%' % line.rate"/></td>
                                        <td class="text-right">
                                            <t t-esc="line.commission_amount" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Adjustments -->
                        <t t-if="doc.adjustment_ids.filtered(lambda a: a.state == 'applied')">
                            <h4 class="mt-3">Adjustments</h4>
                            <table class="table table-sm">
                                <thead class="thead-dark">
                                    <tr>
                                        <th>Reference</th>
                                        <th>Type</th>
                                        <th>Reason</th>
                                        <th class="text-right">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="doc.adjustment_ids.filtered(lambda a: a.state == 'applied')" t-as="adj">
                                        <tr>
                                            <td><t t-esc="adj.name"/></td>
                                            <td><t t-esc="dict(adj._fields['adjustment_type'].selection).get(adj.adjustment_type, '')"/></td>
                                            <td><t t-esc="adj.reason or ''"/></td>
                                            <td class="text-right">
                                                <t t-esc="adj.amount" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                        <!-- Totals -->
                        <div class="row mt-3">
                            <div class="col-6 offset-6">
                                <table class="table table-sm">
                                    <tr>
                                        <th>Gross Commission:</th>
                                        <td class="text-right">
                                            <t t-esc="doc.gross_commission" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                        </td>
                                    </tr>
                                    <tr t-if="doc.total_adjustments != 0">
                                        <th>Adjustments:</th>
                                        <td class="text-right">
                                            <t t-esc="doc.total_adjustments" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                        </td>
                                    </tr>
                                    <tr class="font-weight-bold border-top">
                                        <th>NET COMMISSION:</th>
                                        <td class="text-right">
                                            <t t-esc="doc.total_commission" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Notes -->
                        <t t-if="doc.notes">
                            <div class="mt-3">
                                <strong>Notes:</strong> <t t-esc="doc.notes"/>
                            </div>
                        </t>

                        <!-- Footer disclaimer -->
                        <div class="mt-4 text-muted small">
                            <p>This statement is generated automatically by the Advanced Commission Engine.
                               For disputes or queries, please contact your commission manager or submit
                               a dispute through the employee portal.</p>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Payout Summary Report Template -->
    <template id="report_payout_summary">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Commission Payout Summary</h2>
                        <h4><t t-esc="doc.name"/></h4>
                        <p class="text-muted">
                            Period: <t t-esc="doc.date_start"/> to <t t-esc="doc.date_end"/>
                        </p>

                        <table class="table table-sm table-striped mt-3">
                            <thead class="thead-dark">
                                <tr>
                                    <th>Employee</th>
                                    <th>Plan</th>
                                    <th>Status</th>
                                    <th class="text-right">Gross</th>
                                    <th class="text-right">Adjustments</th>
                                    <th class="text-right">Net Commission</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="data.get(doc.id, {}).get('settlements', [])" t-as="stl">
                                    <tr>
                                        <td><t t-esc="stl.employee_id.name"/></td>
                                        <td><t t-esc="stl.plan_id.name"/></td>
                                        <td><t t-esc="dict(stl._fields['state'].selection).get(stl.state, '')"/></td>
                                        <td class="text-right">
                                            <t t-esc="stl.gross_commission" t-options="{'widget': 'monetary', 'display_currency': stl.currency_id}"/>
                                        </td>
                                        <td class="text-right">
                                            <t t-esc="stl.total_adjustments" t-options="{'widget': 'monetary', 'display_currency': stl.currency_id}"/>
                                        </td>
                                        <td class="text-right font-weight-bold">
                                            <t t-esc="stl.total_commission" t-options="{'widget': 'monetary', 'display_currency': stl.currency_id}"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr class="font-weight-bold border-top-2">
                                    <td colspan="5" class="text-right">Total Payout:</td>
                                    <td class="text-right">
                                        <t t-esc="data.get(doc.id, {}).get('total', 0)"
                                           t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
