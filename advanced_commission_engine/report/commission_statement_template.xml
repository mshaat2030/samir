<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_commission_statement" model="ir.actions.report">
        <field name="name">Commission Statement</field>
        <field name="model">hr.employee</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">advanced_commission_engine.report_commission_statement</field>
        <field name="report_file">advanced_commission_engine.report_commission_statement</field>
        <field name="print_report_name">'Commission Statement - %s' % object.name</field>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_commission_statement">
        <t t-call="web.html_container">
            <t t-foreach="results" t-as="result">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="row mb-4">
                            <div class="col-8">
                                <h2>Commission Statement</h2>
                                <h4 t-esc="result['employee'].name"/>
                                <p class="text-muted">
                                    <t t-esc="result['employee'].job_id.name or ''"/>
                                    <t t-if="result['employee'].department_id">
                                        · <t t-esc="result['employee'].department_id.name"/>
                                    </t>
                                </p>
                            </div>
                            <div class="col-4 text-end">
                                <strong>Generated:</strong>
                                <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y')"/>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-4">
                                <div class="card text-center p-3">
                                    <h5>Total Commission</h5>
                                    <h3 class="text-primary">
                                        <t t-esc="'{:,.2f}'.format(result['total'])"/>
                                    </h3>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="card text-center p-3">
                                    <h5>Paid</h5>
                                    <h3 class="text-success">
                                        <t t-esc="'{:,.2f}'.format(result['paid'])"/>
                                    </h3>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="card text-center p-3">
                                    <h5>Pending</h5>
                                    <h3 class="text-warning">
                                        <t t-esc="'{:,.2f}'.format(result['pending'])"/>
                                    </h3>
                                </div>
                            </div>
                        </div>

                        <table class="table table-sm table-striped">
                            <thead class="table-dark">
                                <tr>
                                    <th>Date</th>
                                    <th>Description</th>
                                    <th>Plan</th>
                                    <th>Period</th>
                                    <th class="text-end">Base Amount</th>
                                    <th class="text-end">Rate %</th>
                                    <th class="text-end">Commission</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="result['lines']" t-as="line">
                                    <tr>
                                        <td t-esc="line.date"/>
                                        <td t-esc="line.name"/>
                                        <td t-esc="line.plan_id.name"/>
                                        <td t-esc="line.period_id.name"/>
                                        <td class="text-end" t-esc="'{:,.2f}'.format(line.base_amount)"/>
                                        <td class="text-end" t-esc="'{:.2f}'.format(line.rate)"/>
                                        <td class="text-end fw-bold" t-esc="'{:,.2f}'.format(line.commission_amount)"/>
                                        <td>
                                            <span t-esc="dict(line._fields['state'].selection).get(line.state)"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr class="table-dark">
                                    <th colspan="6" class="text-end">TOTAL:</th>
                                    <th class="text-end" t-esc="'{:,.2f}'.format(result['total'])"/>
                                    <th/>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
