<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- PDF: Commission Statement -->
    <record id="action_report_commission_statement" model="ir.actions.report">
        <field name="name">Commission Statement</field>
        <field name="model">commission.settlement</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">advanced_commission_engine.report_commission_statement</field>
        <field name="report_file">advanced_commission_engine.report_commission_statement</field>
        <field name="binding_model_id" ref="model_commission_settlement"/>
        <field name="binding_type">report</field>
        <field name="groups_id" eval="[(4, ref('group_commission_user'))]"/>
    </record>

    <!-- XLSX: Commission Statement -->
    <record id="action_report_commission_statement_xlsx" model="ir.actions.report">
        <field name="name">Commission Statement (XLSX)</field>
        <field name="model">commission.settlement</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">advanced_commission_engine.report_commission_statement_xlsx</field>
        <field name="report_file">advanced_commission_engine.report_commission_statement_xlsx</field>
        <field name="binding_model_id" ref="model_commission_settlement"/>
        <field name="binding_type">report</field>
        <field name="groups_id" eval="[(4, ref('group_commission_user'))]"/>
    </record>

    <!-- PDF: Payout Summary -->
    <record id="action_report_payout_summary" model="ir.actions.report">
        <field name="name">Payout Summary</field>
        <field name="model">commission.period</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">advanced_commission_engine.report_payout_summary</field>
        <field name="report_file">advanced_commission_engine.report_payout_summary</field>
        <field name="binding_model_id" ref="model_commission_period"/>
        <field name="binding_type">report</field>
        <field name="groups_id" eval="[(4, ref('group_commission_finance_manager'))]"/>
    </record>

</odoo>
