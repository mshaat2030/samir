<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_commission_simulation_list" model="ir.ui.view">
        <field name="name">commission.simulation.list</field>
        <field name="model">commission.simulation</field>
        <field name="arch" type="xml">
            <list string="Commission Simulations"
                  decoration-success="state == 'computed'">
                <field name="name"/>
                <field name="plan_id"/>
                <field name="employee_id"/>
                <field name="scenario_type"/>
                <field name="base_amount"/>
                <field name="achievement_pct" string="Ach. %"/>
                <field name="result_commission" sum="Total" string="Simulated Commission"/>
                <field name="currency_id" invisible="1"/>
                <field name="state" widget="badge"/>
                <field name="create_date" string="Created"/>
            </list>
        </field>
    </record>

    <record id="view_commission_simulation_form" model="ir.ui.view">
        <field name="name">commission.simulation.form</field>
        <field name="model">commission.simulation</field>
        <field name="arch" type="xml">
            <form string="Commission Simulation">
                <header>
                    <button name="action_run_simulation" type="object" string="Run Simulation"
                            class="btn-primary" attrs="{'invisible': [('state','=','computed')]}"/>
                    <button name="action_run_simulation" type="object" string="Re-Run"
                            attrs="{'invisible': [('state','!=','computed')]}"/>
                    <button name="action_reset" type="object" string="Reset"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,computed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Setup">
                            <field name="plan_id"/>
                            <field name="employee_id"/>
                            <field name="scenario_type"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Parameters">
                            <field name="base_amount"
                                   attrs="{'invisible': [('scenario_type','=','achievement')]}"/>
                            <field name="margin_pct"/>
                            <field name="achievement_pct"/>
                            <field name="kpi_score"
                                   attrs="{'invisible': [('plan_id.calculation_method','!=','weighted_kpi')]}"/>
                            <field name="custom_params"
                                   attrs="{'invisible': [('scenario_type','!=','custom')]}"/>
                        </group>
                    </group>
                    <group string="Range Simulation">
                        <field name="simulate_range"/>
                        <field name="range_from" attrs="{'invisible': [('simulate_range','=',False)]}"/>
                        <field name="range_to" attrs="{'invisible': [('simulate_range','=',False)]}"/>
                        <field name="range_step" attrs="{'invisible': [('simulate_range','=',False)]}"/>
                    </group>
                    <!-- Results -->
                    <div attrs="{'invisible': [('state','!=','computed')]}">
                        <separator string="Simulation Results"/>
                        <group>
                            <group>
                                <field name="result_commission" readonly="1"
                                       class="o_field_monetary font-weight-bold text-success"/>
                            </group>
                        </group>
                        <field name="result_breakdown" readonly="1" widget="text"
                               style="font-family: monospace; font-size: 0.9em;"/>
                    </div>
                    <field name="notes" placeholder="Assumptions and notes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_commission_simulation" model="ir.actions.act_window">
        <field name="name">Commission Simulations</field>
        <field name="res_model">commission.simulation</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
