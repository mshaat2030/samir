<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_commission_simulation_form" model="ir.ui.view">
        <field name="name">commission.simulation.form</field>
        <field name="model">commission.simulation</field>
        <field name="arch" type="xml">
            <form string="Commission Simulation">
                <header>
                    <button name="action_compute" type="object"
                        string="Compute" class="btn-primary"
                        invisible="state == 'computed'"/>
                    <button name="action_run_scenarios" type="object"
                        string="Run All Scenarios" class="btn-secondary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Simulation Name..."/></h1>
                    </div>
                    <group>
                        <group string="Parameters">
                            <field name="plan_id" required="1"/>
                            <field name="employee_id"/>
                            <field name="simulation_date"/>
                            <field name="base_amount" required="1"/>
                            <field name="margin_percent"/>
                            <field name="target_amount"/>
                            <field name="achieved_percent"/>
                            <field name="quantity"/>
                        </group>
                        <group string="Results" invisible="state != 'computed'">
                            <field name="computed_commission" readonly="1"
                                class="text-success fw-bold"/>
                            <field name="effective_rate" readonly="1"/>
                        </group>
                    </group>
                    <separator string="Scenario Results" invisible="not simulation_line_ids"/>
                    <field name="simulation_line_ids" readonly="1">
                        <list>
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="base_amount"/>
                            <field name="commission_amount" class="fw-bold"/>
                            <field name="rate" string="Rate (%)"/>
                            <field name="note"/>
                        </list>
                    </field>
                    <field name="note" placeholder="Notes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_commission_simulation_list" model="ir.ui.view">
        <field name="name">commission.simulation.list</field>
        <field name="model">commission.simulation</field>
        <field name="arch" type="xml">
            <list string="Commission Simulations">
                <field name="name"/>
                <field name="plan_id"/>
                <field name="employee_id"/>
                <field name="base_amount"/>
                <field name="computed_commission" class="fw-bold"/>
                <field name="effective_rate"/>
                <field name="simulation_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_commission_simulation" model="ir.actions.act_window">
        <field name="name">Commission Simulations</field>
        <field name="res_model">commission.simulation</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Simulate your commission scenarios!</p>
        </field>
    </record>

</odoo>
