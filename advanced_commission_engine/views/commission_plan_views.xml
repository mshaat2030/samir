<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Form View ── -->
    <record id="view_commission_plan_form" model="ir.ui.view">
        <field name="name">commission.plan.form</field>
        <field name="model">commission.plan</field>
        <field name="arch" type="xml">
            <form string="Commission Plan">
                <header>
                    <button name="action_activate" string="Activate" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_draft" string="Reset to Draft" type="object"
                            invisible="state not in ('active',)"/>
                    <button name="action_archive_plan" string="Archive" type="object"
                            invisible="state != 'active'"/>
                    <button name="action_simulate" string="Simulate" type="object"
                            class="btn-secondary"/>
                    <button name="action_new_version" string="New Version" type="object"
                            class="btn-secondary"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,archived"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_rules" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="rule_count" string="Rules" widget="statinfo"/>
                        </button>
                        <button name="action_view_settlements" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="settlement_count" string="Settlements" widget="statinfo"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Plan Name..."/>
                        </h1>
                        <div>
                            <field name="code" placeholder="PLAN-CODE" class="text-muted"/>
                        </div>
                    </div>
                    <group>
                        <group string="Plan Configuration">
                            <field name="commission_type"/>
                            <field name="calculation_method"/>
                            <field name="period_type"/>
                            <field name="source_document"/>
                            <field name="active" invisible="1"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group string="Validity">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Rules" name="rules">
                            <field name="rule_ids" context="{'default_plan_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="calculation_method"/>
                                    <field name="rate"/>
                                    <field name="fixed_amount"/>
                                    <field name="slab_from"/>
                                    <field name="slab_to"/>
                                    <field name="cap_amount"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>

                        <page string="Eligibility" name="eligibility">
                            <group>
                                <group string="People">
                                    <field name="employee_ids" widget="many2many_tags"/>
                                    <field name="team_ids" widget="many2many_tags"/>
                                    <field name="department_ids" widget="many2many_tags"/>
                                    <field name="job_ids" widget="many2many_tags"/>
                                </group>
                                <group string="Products &amp; Customers">
                                    <field name="product_ids" widget="many2many_tags"/>
                                    <field name="product_category_ids" widget="many2many_tags"/>
                                    <field name="partner_ids" widget="many2many_tags"/>
                                    <field name="country_ids" widget="many2many_tags"/>
                                    <field name="country_group_ids" widget="many2many_tags"/>
                                </group>
                            </group>
                        </page>

                        <page string="Calculation" name="calculation">
                            <group>
                                <group string="Invoice Settings">
                                    <field name="invoice_state_trigger"/>
                                    <field name="include_tax"/>
                                    <field name="collection_delay_days"/>
                                    <field name="collection_delay_penalty_pct"
                                           invisible="collection_delay_days == 0"/>
                                </group>
                                <group string="Formula &amp; KPIs"
                                       invisible="calculation_method not in ('dynamic_formula', 'weighted_kpi')">
                                    <field name="formula_id"
                                           invisible="calculation_method != 'dynamic_formula'"/>
                                    <field name="kpi_ids" widget="many2many_tags"
                                           invisible="calculation_method != 'weighted_kpi'"/>
                                </group>
                            </group>
                        </page>

                        <page string="Approval" name="approval">
                            <group>
                                <group string="Workflow">
                                    <field name="approval_required"/>
                                    <field name="finance_approval_required"/>
                                    <field name="auto_approve_below"/>
                                </group>
                            </group>
                        </page>

                        <page string="Accounting" name="accounting">
                            <group>
                                <group string="Journal Settings">
                                    <field name="journal_id"/>
                                    <field name="expense_account_id"/>
                                    <field name="payable_account_id"/>
                                    <field name="analytic_account_id"/>
                                    <field name="create_accrual"/>
                                </group>
                                <group string="Payroll">
                                    <field name="payroll_input_type_id"/>
                                    <field name="is_taxable"/>
                                </group>
                            </group>
                        </page>

                        <page string="Gamification" name="gamification">
                            <group>
                                <field name="enable_leaderboard"/>
                                <field name="enable_badges"/>
                            </group>
                        </page>
                    </notebook>
                    <field name="description" placeholder="Internal description..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── List View ── -->
    <record id="view_commission_plan_list" model="ir.ui.view">
        <field name="name">commission.plan.list</field>
        <field name="model">commission.plan</field>
        <field name="arch" type="xml">
            <list string="Commission Plans" decoration-muted="state == 'archived'">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="commission_type"/>
                <field name="calculation_method"/>
                <field name="period_type"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="rule_count"/>
                <field name="settlement_count"/>
                <field name="total_paid" sum="Total Paid"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'draft'"
                       decoration-danger="state == 'archived'"/>
            </list>
        </field>
    </record>

    <!-- ── Kanban View ── -->
    <record id="view_commission_plan_kanban" model="ir.ui.view">
        <field name="name">commission.plan.kanban</field>
        <field name="model">commission.plan</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="id"/>
                <field name="name"/>
                <field name="commission_type"/>
                <field name="state"/>
                <field name="settlement_count"/>
                <field name="total_paid"/>
                <field name="currency_id"/>
                <field name="color"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_color_#{record.color.raw_value} oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <div class="o_kanban_manage_toggle_button"/>
                            </div>
                            <div class="o_kanban_record_body">
                                <span class="badge text-bg-info">
                                    <field name="commission_type"/>
                                </span>
                                <div class="mt-2">
                                    <i class="fa fa-file-text-o me-1"/>
                                    <field name="settlement_count"/> settlements
                                </div>
                                <div>
                                    <i class="fa fa-money me-1"/>
                                    <field name="total_paid" widget="monetary"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <field name="state" widget="badge"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ── Search View ── -->
    <record id="view_commission_plan_search" model="ir.ui.view">
        <field name="name">commission.plan.search</field>
        <field name="model">commission.plan</field>
        <field name="arch" type="xml">
            <search string="Search Commission Plans">
                <field name="name"/>
                <field name="code"/>
                <field name="commission_type"/>
                <filter string="Active" name="active" domain="[('state','=','active')]"/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Archived" name="archived" domain="[('active','=',False)]"/>
                <separator/>
                <filter string="Sales" name="sales" domain="[('commission_type','=','sales')]"/>
                <filter string="KPI Incentive" name="kpi" domain="[('commission_type','=','kpi_incentive')]"/>
                <group>
                    <filter string="Commission Type" name="groupby_type" context="{'group_by':'commission_type'}"/>
                    <filter string="Calculation Method" name="groupby_method" context="{'group_by':'calculation_method'}"/>
                    <filter string="Period Type" name="groupby_period" context="{'group_by':'period_type'}"/>
                    <filter string="State" name="groupby_state" context="{'group_by':'state'}"/>
                </group>
                <searchpanel>
                    <field name="commission_type" string="Type" icon="fa-tag"/>
                    <field name="state" string="State" icon="fa-circle"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- ── Action ── -->
    <record id="action_commission_plan" model="ir.actions.act_window">
        <field name="name">Commission Plans</field>
        <field name="res_model">commission.plan</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first commission plan!
            </p>
            <p>
                Commission plans define how employees earn commissions based on
                sales, collections, KPIs, or custom formulas.
            </p>
        </field>
    </record>
</odoo>
