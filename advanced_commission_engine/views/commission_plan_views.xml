<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Search ──────────────────────────────────────────────────────────── -->
    <record id="view_commission_plan_search" model="ir.ui.view">
        <field name="name">commission.plan.search</field>
        <field name="model">commission.plan</field>
        <field name="arch" type="xml">
            <search string="Commission Plans">
                <field name="name"/>
                <field name="code"/>
                <field name="commission_type"/>
                <filter string="Active" name="active" domain="[('active','=',True)]"/>
                <filter string="Archived" name="archived" domain="[('active','=',False)]"/>
                <separator/>
                <filter string="Sales" name="sales" domain="[('commission_type','=','sales')]"/>
                <filter string="Collection" name="collection" domain="[('commission_type','=','collection')]"/>
                <filter string="KPI Incentive" name="kpi" domain="[('commission_type','=','kpi_incentive')]"/>
                <group expand="0" string="Group By">
                    <filter string="Type" name="group_type" context="{'group_by': 'commission_type'}"/>
                    <filter string="Method" name="group_method" context="{'group_by': 'calculation_method'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── List ────────────────────────────────────────────────────────────── -->
    <record id="view_commission_plan_list" model="ir.ui.view">
        <field name="name">commission.plan.list</field>
        <field name="model">commission.plan</field>
        <field name="arch" type="xml">
            <list string="Commission Plans" decoration-muted="not active">
                <field name="name"/>
                <field name="code"/>
                <field name="commission_type"/>
                <field name="calculation_method"/>
                <field name="base_on"/>
                <field name="rule_count" string="Rules"/>
                <field name="employee_count" string="Employees"/>
                <field name="total_paid" sum="Total Paid"/>
                <field name="currency_id" invisible="1"/>
                <field name="active" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ── Kanban ──────────────────────────────────────────────────────────── -->
    <record id="view_commission_plan_kanban" model="ir.ui.view">
        <field name="name">commission.plan.kanban</field>
        <field name="model">commission.plan</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="commission_type">
                <field name="name"/>
                <field name="code"/>
                <field name="commission_type"/>
                <field name="calculation_method"/>
                <field name="rule_count"/>
                <field name="employee_count"/>
                <field name="total_paid"/>
                <field name="currency_id"/>
                <field name="active"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_card_header">
                            <div class="o_kanban_card_header_title">
                                <span class="o_primary"><field name="name"/></span>
                                <span class="o_secondary"><field name="code"/></span>
                            </div>
                        </div>
                        <div class="o_kanban_card_content">
                            <div class="row">
                                <div class="col-6">
                                    <span class="badge badge-info"><field name="commission_type"/></span>
                                </div>
                                <div class="col-6 text-right">
                                    <span class="badge badge-secondary"><field name="calculation_method"/></span>
                                </div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-4 text-center">
                                    <strong><field name="rule_count"/></strong><br/><small>Rules</small>
                                </div>
                                <div class="col-4 text-center">
                                    <strong><field name="employee_count"/></strong><br/><small>Employees</small>
                                </div>
                                <div class="col-4 text-center">
                                    <strong><field name="total_paid" widget="monetary"/></strong><br/><small>Paid YTD</small>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ── Form ────────────────────────────────────────────────────────────── -->
    <record id="view_commission_plan_form" model="ir.ui.view">
        <field name="name">commission.plan.form</field>
        <field name="model">commission.plan</field>
        <field name="arch" type="xml">
            <form string="Commission Plan">
                <sheet>
                    <!-- Smart Buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_rules" type="object" class="oe_stat_button" icon="fa-list-ul">
                            <field name="rule_count" widget="statinfo" string="Rules"/>
                        </button>
                        <button name="action_view_settlements" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="settlement_count" widget="statinfo" string="Settlements"/>
                        </button>
                        <button name="action_view_settlements" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="employee_count" widget="statinfo" string="Employees"/>
                        </button>
                        <field name="active" widget="boolean_button" options="{'terminology': 'active'}"/>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Commission Plan Name"/></h1>
                        <h4><field name="code" placeholder="CODE" class="text-muted"/></h4>
                    </div>
                    <group>
                        <group string="Type &amp; Method">
                            <field name="commission_type"/>
                            <field name="calculation_method"/>
                            <field name="base_on"/>
                            <field name="formula_id" attrs="{'invisible': [('calculation_method','!=','dynamic_formula')], 'required': [('calculation_method','=','dynamic_formula')]}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Limits">
                            <field name="min_base_amount"/>
                            <field name="max_base_amount"/>
                            <field name="min_commission"/>
                            <field name="max_commission"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Rules" name="rules">
                            <field name="rule_ids" context="{'default_plan_id': active_id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="calculation_method"/>
                                    <field name="rate"/>
                                    <field name="amount"/>
                                    <field name="filter_type"/>
                                    <field name="stop_further_rules"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Employees &amp; Teams" name="assignment">
                            <group>
                                <field name="employee_ids" widget="many2many_tags"/>
                                <field name="team_ids" widget="many2many_tags"/>
                            </group>
                        </page>
                        <page string="Workflow" name="workflow">
                            <group>
                                <group string="Approval">
                                    <field name="require_manager_approval"/>
                                    <field name="require_finance_approval"/>
                                    <field name="require_hr_approval"/>
                                    <field name="auto_approve_threshold"/>
                                </group>
                                <group string="Payout">
                                    <field name="is_deferred" invisible="1"/>
                                    <field name="enable_split_payout"/>
                                    <field name="split_payout_count" attrs="{'invisible': [('enable_split_payout','=',False)]}"/>
                                    <field name="enable_clawback"/>
                                    <field name="clawback_period_months" attrs="{'invisible': [('enable_clawback','=',False)]}"/>
                                </group>
                            </group>
                        </page>
                        <page string="Collection" name="collection">
                            <group>
                                <field name="collection_delay_penalty"/>
                                <field name="max_invoice_age_days"/>
                            </group>
                        </page>
                        <page string="Accounting" name="accounting">
                            <group>
                                <field name="account_id"/>
                                <field name="journal_id"/>
                                <field name="analytic_account_id"/>
                                <field name="is_taxable"/>
                                <field name="payroll_salary_rule_id"/>
                            </group>
                        </page>
                        <page string="Gamification" name="gamification">
                            <group>
                                <field name="enable_gamification"/>
                                <field name="enable_leaderboard"/>
                                <field name="enable_badges"/>
                            </group>
                        </page>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Plan description..."/>
                            <field name="notes" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ── Action ──────────────────────────────────────────────────────────── -->
    <record id="action_commission_plan" model="ir.actions.act_window">
        <field name="name">Commission Plans</field>
        <field name="res_model">commission.plan</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

</odoo>
