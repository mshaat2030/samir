<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_commission_leaderboard_list" model="ir.ui.view">
        <field name="name">commission.leaderboard.list</field>
        <field name="model">commission.leaderboard</field>
        <field name="arch" type="xml">
            <list string="Commission Leaderboard" create="0" delete="0" edit="0">
                <field name="rank" string="#"/>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="department_id"/>
                <field name="commission_amount" class="fw-bold" sum="Total"/>
                <field name="base_amount" sum="Total Revenue"/>
                <field name="achievement_percent" widget="progressbar"
                    options="{'editable': false}"/>
                <field name="lines_count" string="Transactions"/>
                <field name="rank_trend" widget="badge"
                    decoration-success="rank_trend == 'up'"
                    decoration-danger="rank_trend == 'down'"
                    decoration-info="rank_trend == 'same'"
                    decoration-warning="rank_trend == 'new'"/>
                <field name="rank_change"/>
                <field name="is_top_performer" widget="boolean" string="⭐"/>
                <field name="is_most_improved" widget="boolean" string="🚀"/>
            </list>
        </field>
    </record>

    <record id="view_commission_leaderboard_search" model="ir.ui.view">
        <field name="name">commission.leaderboard.search</field>
        <field name="model">commission.leaderboard</field>
        <field name="arch" type="xml">
            <search string="Leaderboard">
                <field name="employee_id"/>
                <field name="period_id"/>
                <filter name="top3" string="Top 3"
                    domain="[('is_top_performer', '=', True)]"/>
                <filter name="improved" string="Most Improved"
                    domain="[('is_most_improved', '=', True)]"/>
                <separator/>
                <group>
                    <filter name="group_dept" string="Department"
                        context="{'group_by': 'department_id'}"/>
                    <filter name="group_team" string="Team"
                        context="{'group_by': 'team_id'}"/>
                    <filter name="group_period" string="Period"
                        context="{'group_by': 'period_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_commission_leaderboard" model="ir.actions.act_window">
        <field name="name">Commission Leaderboard</field>
        <field name="res_model">commission.leaderboard</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_commission_leaderboard_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Leaderboard will appear once commissions are computed.</p>
        </field>
    </record>

</odoo>
