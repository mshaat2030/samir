<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_commission_target_form" model="ir.ui.view">
        <field name="name">commission.target.form</field>
        <field name="model">commission.target</field>
        <field name="arch" type="xml">
            <form string="Commission Target">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" required="1"/>
                            <field name="period_id" required="1"/>
                            <field name="plan_id" required="1"/>
                            <field name="target_type"/>
                        </group>
                        <group>
                            <field name="target_amount"
                                invisible="target_type not in ('revenue', 'margin')"/>
                            <field name="target_quantity"
                                invisible="target_type in ('revenue', 'margin')"/>
                            <field name="achieved_amount" readonly="1"
                                invisible="target_type not in ('revenue', 'margin')"/>
                            <field name="achieved_quantity" readonly="1"
                                invisible="target_type in ('revenue', 'margin')"/>
                        </group>
                    </group>
                    <group string="Achievement">
                        <div class="o_field_widget">
                            <field name="achievement_percent" widget="progressbar"
                                options="{'editable': false, 'max_value': 100, 'overflow': true}"/>
                        </div>
                        <field name="status_label" readonly="1"/>
                        <field name="color" invisible="1"/>
                    </group>
                    <group string="Threshold Configuration">
                        <field name="threshold_type"/>
                        <field name="minimum_threshold"
                            invisible="threshold_type != 'minimum'"/>
                        <field name="quota_tiers"
                            invisible="threshold_type != 'quota'"
                            widget="code"
                            placeholder='[{"from": 0, "to": 80, "rate": 0.5}, {"from": 80, "to": 100, "rate": 1.0}, {"from": 100, "to": 0, "rate": 1.5}]'/>
                    </group>
                    <field name="note" placeholder="Notes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_commission_target_list" model="ir.ui.view">
        <field name="name">commission.target.list</field>
        <field name="model">commission.target</field>
        <field name="arch" type="xml">
            <list string="Commission Targets"
                decoration-success="achievement_percent >= 100"
                decoration-warning="achievement_percent >= 75 and achievement_percent &lt; 100"
                decoration-danger="achievement_percent &lt; 50">
                <field name="employee_id"/>
                <field name="period_id"/>
                <field name="plan_id"/>
                <field name="target_type" widget="badge"/>
                <field name="target_amount"/>
                <field name="achieved_amount"/>
                <field name="achievement_percent" widget="progressbar"
                    options="{'editable': false}"/>
                <field name="status_label"/>
                <field name="threshold_type"/>
            </list>
        </field>
    </record>

    <record id="action_commission_target" model="ir.actions.act_window">
        <field name="name">Commission Targets</field>
        <field name="res_model">commission.target</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Set your first commission target!</p>
        </field>
    </record>

</odoo>
