<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_commission_target_form" model="ir.ui.view">
        <field name="name">commission.target.form</field>
        <field name="model">commission.target</field>
        <field name="arch" type="xml">
            <form string="Commission Target">
                <header>
                    <button name="action_activate" string="Activate" type="object"
                            invisible="state != 'draft'"/>
                    <button name="action_close" string="Close" type="object"
                            invisible="state != 'active'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Target Details">
                            <field name="employee_id"/>
                            <field name="plan_id"/>
                            <field name="period_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Progress">
                            <field name="overall_attainment" readonly="1"/>
                            <field name="progress_bar_value" string="Progress %" readonly="1"/>
                            <field name="progress_color" string="Status" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Revenue">
                            <field name="revenue_target"/>
                            <field name="revenue_achieved" readonly="1"/>
                            <field name="revenue_attainment" readonly="1"/>
                        </group>
                        <group string="Commission">
                            <field name="commission_target"/>
                            <field name="commission_achieved" readonly="1"/>
                            <field name="commission_attainment" readonly="1"/>
                        </group>
                        <group string="Other Targets">
                            <field name="units_target"/>
                            <field name="new_customers_target"/>
                            <field name="collection_target"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="KPI Values" name="kpis">
                            <field name="kpi_value_ids">
                                <list editable="bottom">
                                    <field name="kpi_id"/>
                                    <field name="target_value"/>
                                    <field name="achieved_value"/>
                                    <field name="weight" readonly="1"/>
                                    <field name="attainment_pct" readonly="1"/>
                                    <field name="weighted_score" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_commission_target_list" model="ir.ui.view">
        <field name="name">commission.target.list</field>
        <field name="model">commission.target</field>
        <field name="arch" type="xml">
            <list string="Commission Targets"
                  decoration-success="overall_attainment >= 100"
                  decoration-warning="overall_attainment >= 75 and overall_attainment &lt; 100"
                  decoration-danger="overall_attainment &lt; 50">
                <field name="employee_id"/>
                <field name="plan_id"/>
                <field name="period_id"/>
                <field name="revenue_target" sum="Target Revenue"/>
                <field name="revenue_achieved" sum="Achieved Revenue"/>
                <field name="commission_target" sum="Commission Target"/>
                <field name="commission_achieved" sum="Commission Achieved"/>
                <field name="overall_attainment" widget="progressbar"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_commission_target" model="ir.actions.act_window">
        <field name="name">Commission Targets</field>
        <field name="res_model">commission.target</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_commission_target_my" model="ir.actions.act_window">
        <field name="name">My Targets</field>
        <field name="res_model">commission.target</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('employee_id.user_id','=',uid)]</field>
    </record>
</odoo>
