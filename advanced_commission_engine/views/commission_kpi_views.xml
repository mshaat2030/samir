<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_commission_kpi_form" model="ir.ui.view">
        <field name="name">commission.kpi.form</field>
        <field name="model">commission.kpi</field>
        <field name="arch" type="xml">
            <form string="KPI">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="KPI Name..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="category"/>
                            <field name="unit"/>
                            <field name="weight"/>
                            <field name="higher_is_better"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_commission_kpi_list" model="ir.ui.view">
        <field name="name">commission.kpi.list</field>
        <field name="model">commission.kpi</field>
        <field name="arch" type="xml">
            <list string="KPIs" editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="unit"/>
                <field name="weight"/>
                <field name="higher_is_better"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_commission_kpi" model="ir.actions.act_window">
        <field name="name">KPI Definitions</field>
        <field name="res_model">commission.kpi</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
