<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_commission_kpi_form" model="ir.ui.view">
        <field name="name">commission.kpi.form</field>
        <field name="model">commission.kpi</field>
        <field name="arch" type="xml">
            <form string="Commission KPI">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="KPI Name..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="plan_id"/>
                            <field name="code"/>
                            <field name="kpi_type"/>
                            <field name="weight"/>
                            <field name="unit"/>
                        </group>
                        <group string="Target">
                            <field name="target_value"/>
                            <field name="min_value"/>
                            <field name="max_value"/>
                            <field name="payout_cap"/>
                        </group>
                    </group>
                    <group string="Measurement">
                        <field name="measurement_method"/>
                        <field name="auto_source"
                            invisible="measurement_method != 'automatic'"/>
                        <field name="formula" widget="code"
                            invisible="measurement_method != 'formula'"
                            placeholder="# Return achievement value\nreturn 85.0"/>
                        <field name="scale_type"/>
                    </group>
                    <field name="description" placeholder="KPI description..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_commission_kpi_list" model="ir.ui.view">
        <field name="name">commission.kpi.list</field>
        <field name="model">commission.kpi</field>
        <field name="arch" type="xml">
            <list string="Commission KPIs" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="plan_id"/>
                <field name="kpi_type" widget="badge"/>
                <field name="target_value"/>
                <field name="weight"/>
                <field name="measurement_method"/>
                <field name="payout_cap"/>
            </list>
        </field>
    </record>

    <record id="action_commission_kpi" model="ir.actions.act_window">
        <field name="name">Commission KPIs</field>
        <field name="res_model">commission.kpi</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
