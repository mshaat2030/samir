<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_commission_rule_form" model="ir.ui.view">
        <field name="name">commission.rule.form</field>
        <field name="model">commission.rule</field>
        <field name="arch" type="xml">
            <form string="Commission Rule">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Rule Name..."/></h1>
                    </div>
                    <group>
                        <group string="Rule Configuration">
                            <field name="plan_id"/>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="calculation_method" readonly="1"/>
                        </group>
                        <group string="Commission Parameters">
                            <field name="rate"
                                   invisible="calculation_method == 'fixed_amount'"/>
                            <field name="fixed_amount"
                                   invisible="calculation_method not in ('fixed_amount', 'hybrid')"/>
                            <field name="formula_id"
                                   invisible="calculation_method != 'dynamic_formula'"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Slabs" name="slabs"
                              invisible="calculation_method not in ('progressive_slabs', 'tiered')">
                            <group>
                                <group string="Rule Slab">
                                    <field name="slab_from"/>
                                    <field name="slab_to"/>
                                </group>
                            </group>
                            <field name="slab_ids">
                                <list editable="bottom">
                                    <field name="slab_from"/>
                                    <field name="slab_to"/>
                                    <field name="rate_type"/>
                                    <field name="rate"/>
                                    <field name="fixed_amount"/>
                                </list>
                            </field>
                        </page>

                        <page string="Conditions" name="conditions">
                            <group>
                                <group string="Amount Range">
                                    <field name="min_base_amount"/>
                                    <field name="max_base_amount"/>
                                </group>
                                <group string="Margin">
                                    <field name="min_margin_pct"/>
                                    <field name="max_margin_pct"/>
                                </group>
                            </group>
                            <group>
                                <group string="Filters">
                                    <field name="product_ids" widget="many2many_tags"/>
                                    <field name="product_category_ids" widget="many2many_tags"/>
                                    <field name="partner_ids" widget="many2many_tags"/>
                                    <field name="country_ids" widget="many2many_tags"/>
                                    <field name="payment_term_ids" widget="many2many_tags"/>
                                </group>
                                <group string="Domain Filter">
                                    <field name="condition_domain" widget="domain"
                                           options="{'model': 'account.move'}"/>
                                </group>
                            </group>
                        </page>

                        <page string="Caps &amp; Penalties" name="caps">
                            <group>
                                <group string="Commission Cap">
                                    <field name="cap_amount"/>
                                    <field name="cap_period"/>
                                </group>
                                <group string="Collection Delay Penalty">
                                    <field name="apply_delay_penalty"/>
                                    <field name="delay_penalty_days" invisible="not apply_delay_penalty"/>
                                    <field name="delay_penalty_pct" invisible="not apply_delay_penalty"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_commission_rule_list" model="ir.ui.view">
        <field name="name">commission.rule.list</field>
        <field name="model">commission.rule</field>
        <field name="arch" type="xml">
            <list string="Commission Rules">
                <field name="sequence" widget="handle"/>
                <field name="plan_id"/>
                <field name="name"/>
                <field name="calculation_method"/>
                <field name="rate"/>
                <field name="fixed_amount"/>
                <field name="slab_from"/>
                <field name="slab_to"/>
                <field name="cap_amount"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_commission_rule_search" model="ir.ui.view">
        <field name="name">commission.rule.search</field>
        <field name="model">commission.rule</field>
        <field name="arch" type="xml">
            <search string="Search Rules">
                <field name="name"/>
                <field name="plan_id"/>
                <filter string="Active" name="active" domain="[('active','=',True)]"/>
                <group>
                    <filter string="Plan" name="groupby_plan" context="{'group_by': 'plan_id'}"/>
                    <filter string="Method" name="groupby_method" context="{'group_by': 'calculation_method'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_commission_rule" model="ir.actions.act_window">
        <field name="name">Commission Rules</field>
        <field name="res_model">commission.rule</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <!-- Formula action -->
    <record id="action_commission_formula" model="ir.actions.act_window">
        <field name="name">Commission Formulas</field>
        <field name="res_model">commission.formula</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
