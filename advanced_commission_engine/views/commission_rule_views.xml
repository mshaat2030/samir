<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_commission_rule_search" model="ir.ui.view">
        <field name="name">commission.rule.search</field>
        <field name="model">commission.rule</field>
        <field name="arch" type="xml">
            <search string="Commission Rules">
                <field name="name"/>
                <field name="plan_id"/>
                <field name="calculation_method"/>
                <filter string="Active" name="active" domain="[('active','=',True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Plan" name="group_plan" context="{'group_by': 'plan_id'}"/>
                    <filter string="Method" name="group_method" context="{'group_by': 'calculation_method'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_commission_rule_list" model="ir.ui.view">
        <field name="name">commission.rule.list</field>
        <field name="model">commission.rule</field>
        <field name="arch" type="xml">
            <list string="Commission Rules" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="plan_id"/>
                <field name="name"/>
                <field name="calculation_method"/>
                <field name="rate" string="Rate %"/>
                <field name="amount" string="Fixed Amount"/>
                <field name="filter_type"/>
                <field name="stop_further_rules"/>
                <field name="active" invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_commission_rule_form" model="ir.ui.view">
        <field name="name">commission.rule.form</field>
        <field name="model">commission.rule</field>
        <field name="arch" type="xml">
            <form string="Commission Rule">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Rule Name"/></h1>
                    </div>
                    <group>
                        <group string="Setup">
                            <field name="plan_id" options="{'no_create': True}"/>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="calculation_method"/>
                            <field name="rate" attrs="{'invisible': [('calculation_method','in',['fixed_amount','dynamic_formula','progressive_slabs','tiered'])]}"/>
                            <field name="amount" attrs="{'invisible': [('calculation_method','!=','fixed_amount')]}"/>
                            <field name="formula_id" attrs="{'invisible': [('calculation_method','!=','dynamic_formula')], 'required': [('calculation_method','=','dynamic_formula')]}"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Behavior">
                            <field name="stop_further_rules"/>
                            <field name="is_additive"/>
                            <field name="min_amount"/>
                            <field name="max_amount"/>
                            <field name="min_achievement_pct"/>
                            <field name="max_achievement_pct"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Slabs" name="slabs"
                              attrs="{'invisible': [('calculation_method','not in',['progressive_slabs','tiered'])]}">
                            <field name="slab_ids">
                                <list editable="bottom">
                                    <field name="from_amount"/>
                                    <field name="to_amount"/>
                                    <field name="rate"/>
                                    <field name="flat_bonus"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>
                        <page string="Filters" name="filters">
                            <group>
                                <field name="filter_type"/>
                            </group>
                            <group attrs="{'invisible': [('filter_type','!=','customer')]}">
                                <field name="customer_ids" widget="many2many_tags"/>
                            </group>
                            <group attrs="{'invisible': [('filter_type','!=','customer_category')]}">
                                <field name="customer_category_ids" widget="many2many_tags"/>
                            </group>
                            <group attrs="{'invisible': [('filter_type','!=','product')]}">
                                <field name="product_ids" widget="many2many_tags"/>
                            </group>
                            <group attrs="{'invisible': [('filter_type','!=','product_category')]}">
                                <field name="product_category_ids" widget="many2many_tags"/>
                            </group>
                            <group attrs="{'invisible': [('filter_type','!=','payment_term')]}">
                                <field name="payment_term_ids" widget="many2many_tags"/>
                            </group>
                            <group attrs="{'invisible': [('filter_type','!=','salesperson')]}">
                                <field name="salesperson_ids" widget="many2many_tags"/>
                            </group>
                            <group attrs="{'invisible': [('filter_type','!=','region')]}">
                                <field name="region"/>
                            </group>
                            <group attrs="{'invisible': [('filter_type','!=','domain')]}">
                                <field name="domain_filter" widget="domain" options="{'model': 'account.move'}"/>
                            </group>
                        </page>
                        <page string="Collection" name="collection">
                            <group>
                                <field name="max_invoice_age_days"/>
                                <field name="collection_delay_penalty_rate"/>
                                <field name="min_quantity"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="description" placeholder="Rule description and conditions..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

</odoo>
