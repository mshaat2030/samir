<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Form View ── -->
    <record id="view_commission_settlement_form" model="ir.ui.view">
        <field name="name">commission.settlement.form</field>
        <field name="model">commission.settlement</field>
        <field name="arch" type="xml">
            <form string="Commission Settlement">
                <header>
                    <button name="action_calculate" string="Calculate" type="object"
                            class="btn-primary"
                            invisible="state not in ('draft', 'calculated')"/>
                    <button name="action_submit" string="Submit for Approval" type="object"
                            class="btn-primary"
                            invisible="state != 'calculated'"/>
                    <button name="action_approve" string="Approve" type="object"
                            class="btn-success"
                            invisible="state != 'submitted'"
                            groups="advanced_commission_engine.group_commission_manager"/>
                    <button name="action_finance_approve" string="Finance Approve" type="object"
                            class="btn-success"
                            invisible="state != 'approved'"
                            groups="advanced_commission_engine.group_commission_finance_manager"/>
                    <button name="action_process_payroll" string="Process Payroll" type="object"
                            invisible="state != 'finance_approved'"
                            groups="advanced_commission_engine.group_commission_hr_manager"/>
                    <button name="action_mark_paid" string="Mark as Paid" type="object"
                            class="btn-success"
                            invisible="state not in ('payroll_processed', 'finance_approved')"
                            groups="advanced_commission_engine.group_commission_finance_manager"/>
                    <button name="action_dispute" string="Raise Dispute" type="object"
                            class="btn-warning"
                            invisible="state not in ('approved', 'finance_approved')"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('paid', 'cancelled')"/>
                    <button name="action_rollback" string="Rollback" type="object"
                            groups="advanced_commission_engine.group_commission_admin"
                            invisible="state == 'draft'"/>
                    <button name="action_print_statement" string="Print Statement"
                            type="object" class="btn-secondary"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,calculated,submitted,approved,finance_approved,payroll_processed,paid"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_lines" type="object"
                                class="oe_stat_button" icon="fa-list">
                            <field name="line_count" string="Lines" widget="statinfo"/>
                        </button>
                        <button type="action" name="%(action_report_commission_statement)d"
                                class="oe_stat_button" icon="fa-file-pdf-o">
                            <span>PDF</span>
                        </button>
                    </div>
                    <!-- Anomaly ribbon -->
                    <widget name="web_ribbon" title="⚠ Anomaly" bg_color="text-bg-warning"
                            invisible="not is_anomaly"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Settlement Details">
                            <field name="employee_id"/>
                            <field name="plan_id"/>
                            <field name="period_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" readonly="1"/>
                        </group>
                        <group string="Amounts">
                            <field name="gross_amount" widget="monetary"/>
                            <field name="total_adjustment" widget="monetary"/>
                            <field name="held_amount" widget="monetary"/>
                            <field name="deferred_amount" widget="monetary"/>
                            <field name="final_amount" widget="monetary" class="fw-bold"/>
                            <field name="payable_amount" widget="monetary" class="text-success fw-bold"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Commission Lines" name="lines">
                            <field name="line_ids" readonly="state not in ('draft', 'calculated')">
                                <list>
                                    <field name="date"/>
                                    <field name="source_type"/>
                                    <field name="res_name"/>
                                    <field name="partner_id"/>
                                    <field name="product_id"/>
                                    <field name="base_amount" sum="Total Base"/>
                                    <field name="commission_rate"/>
                                    <field name="commission_amount" sum="Total Commission"/>
                                    <field name="margin_pct"/>
                                    <field name="payment_delay_days"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>

                        <page string="Adjustments" name="adjustments">
                            <field name="adjustment_ids"
                                   readonly="state in ('paid', 'cancelled')">
                                <list>
                                    <field name="name"/>
                                    <field name="adjustment_type"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="date"/>
                                    <field name="reason"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>

                        <page string="Approvals" name="approvals">
                            <field name="approval_ids" readonly="1">
                                <list>
                                    <field name="approver_id"/>
                                    <field name="level"/>
                                    <field name="state"/>
                                    <field name="date"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>

                        <page string="Disputes" name="disputes">
                            <field name="dispute_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="dispute_type"/>
                                    <field name="current_amount"/>
                                    <field name="requested_amount"/>
                                    <field name="difference"/>
                                    <field name="date_raised"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>

                        <page string="Accounting" name="accounting">
                            <group>
                                <field name="move_id"/>
                                <field name="payslip_id"/>
                                <field name="calculation_date" readonly="1"/>
                                <field name="submitted_date" readonly="1"/>
                                <field name="approved_date" readonly="1"/>
                                <field name="finance_approved_date" readonly="1"/>
                                <field name="paid_date" readonly="1"/>
                            </group>
                        </page>

                        <page string="Anomaly" name="anomaly" invisible="not is_anomaly">
                            <group>
                                <field name="is_anomaly"/>
                                <field name="anomaly_notes"/>
                            </group>
                        </page>
                    </notebook>
                    <field name="notes" placeholder="Internal Notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── List View ── -->
    <record id="view_commission_settlement_list" model="ir.ui.view">
        <field name="name">commission.settlement.list</field>
        <field name="model">commission.settlement</field>
        <field name="arch" type="xml">
            <list string="Commission Settlements"
                  decoration-warning="is_anomaly"
                  decoration-muted="state == 'cancelled'"
                  decoration-success="state == 'paid'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="plan_id"/>
                <field name="period_id"/>
                <field name="gross_amount" sum="Gross"/>
                <field name="total_adjustment" sum="Adjustments"/>
                <field name="final_amount" sum="Final Amount"/>
                <field name="payable_amount" sum="Payable"/>
                <field name="is_anomaly" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-primary="state == 'draft'"
                       decoration-info="state in ('calculated', 'submitted')"
                       decoration-warning="state in ('approved', 'disputed')"
                       decoration-success="state in ('finance_approved', 'payroll_processed', 'paid')"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- ── Kanban ── -->
    <record id="view_commission_settlement_kanban" model="ir.ui.view">
        <field name="name">commission.settlement.kanban</field>
        <field name="model">commission.settlement</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="id"/>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="period_id"/>
                <field name="final_amount"/>
                <field name="payable_amount"/>
                <field name="currency_id"/>
                <field name="state"/>
                <field name="is_anomaly"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <strong><field name="name"/></strong>
                                <t t-if="record.is_anomaly.raw_value">
                                    <span class="badge text-bg-warning ms-1">⚠</span>
                                </t>
                            </div>
                            <div class="o_kanban_record_body">
                                <div><i class="fa fa-user me-1"/><field name="employee_id"/></div>
                                <div><i class="fa fa-calendar me-1"/><field name="period_id"/></div>
                                <div class="fw-bold mt-2">
                                    <field name="payable_amount" widget="monetary"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ── Pivot View ── -->
    <record id="view_commission_settlement_pivot" model="ir.ui.view">
        <field name="name">commission.settlement.pivot</field>
        <field name="model">commission.settlement</field>
        <field name="arch" type="xml">
            <pivot string="Commission Analytics">
                <field name="period_id" type="row"/>
                <field name="employee_id" type="row"/>
                <field name="plan_id" type="col"/>
                <field name="final_amount" type="measure"/>
                <field name="gross_amount" type="measure"/>
                <field name="payable_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ── Graph View ── -->
    <record id="view_commission_settlement_graph" model="ir.ui.view">
        <field name="name">commission.settlement.graph</field>
        <field name="model">commission.settlement</field>
        <field name="arch" type="xml">
            <graph string="Commission Trends" type="bar">
                <field name="period_id" type="row"/>
                <field name="final_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ── Search View ── -->
    <record id="view_commission_settlement_search" model="ir.ui.view">
        <field name="name">commission.settlement.search</field>
        <field name="model">commission.settlement</field>
        <field name="arch" type="xml">
            <search string="Search Settlements">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="plan_id"/>
                <field name="period_id"/>
                <filter string="My Settlements" name="my"
                        domain="[('employee_id.user_id','=',uid)]"/>
                <filter string="Anomalies" name="anomalies" domain="[('is_anomaly','=',True)]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Calculated" name="calculated" domain="[('state','=','calculated')]"/>
                <filter string="Submitted" name="submitted" domain="[('state','=','submitted')]"/>
                <filter string="Approved" name="approved" domain="[('state','in',('approved','finance_approved'))]"/>
                <filter string="Paid" name="paid" domain="[('state','=','paid')]"/>
                <separator/>
                <group>
                    <filter string="Period" name="groupby_period" context="{'group_by':'period_id'}"/>
                    <filter string="Employee" name="groupby_employee" context="{'group_by':'employee_id'}"/>
                    <filter string="Plan" name="groupby_plan" context="{'group_by':'plan_id'}"/>
                    <filter string="State" name="groupby_state" context="{'group_by':'state'}"/>
                </group>
                <searchpanel>
                    <field name="state" string="State" icon="fa-circle"/>
                    <field name="plan_id" string="Plan" icon="fa-file-text-o"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- ── Actions ── -->
    <record id="action_commission_settlement_all" model="ir.actions.act_window">
        <field name="name">All Settlements</field>
        <field name="res_model">commission.settlement</field>
        <field name="view_mode">list,kanban,pivot,graph,form</field>
        <field name="context">{'search_default_groupby_period': 1}</field>
    </record>

    <record id="action_commission_settlement_my" model="ir.actions.act_window">
        <field name="name">My Statements</field>
        <field name="res_model">commission.settlement</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('employee_id.user_id','=',uid)]</field>
        <field name="context">{'search_default_groupby_period': 1}</field>
    </record>

    <!-- Dispute actions -->
    <record id="action_commission_dispute" model="ir.actions.act_window">
        <field name="name">Commission Disputes</field>
        <field name="res_model">commission.dispute</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>
</odoo>
