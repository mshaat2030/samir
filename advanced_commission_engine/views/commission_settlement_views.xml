<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Search ──────────────────────────────────────────────────────────── -->
    <record id="view_commission_settlement_search" model="ir.ui.view">
        <field name="name">commission.settlement.search</field>
        <field name="model">commission.settlement</field>
        <field name="arch" type="xml">
            <search string="Settlements">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="period_id"/>
                <field name="plan_id"/>
                <filter string="My Settlements" name="my_settlements"
                        domain="[('employee_id.user_id','=',uid)]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Calculated" name="calculated" domain="[('state','=','calculated')]"/>
                <filter string="Submitted" name="submitted" domain="[('state','=','submitted')]"/>
                <filter string="Approved" name="approved" domain="[('state','in',['approved','finance_approved'])]"/>
                <filter string="Paid" name="paid" domain="[('state','=','paid')]"/>
                <filter string="Disputed" name="disputed" domain="[('state','=','disputed')]"/>
                <filter string="Anomaly Flagged" name="anomaly" domain="[('anomaly_flag','=',True)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Period" name="group_period" context="{'group_by': 'period_id'}"/>
                    <filter string="Plan" name="group_plan" context="{'group_by': 'plan_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── List ────────────────────────────────────────────────────────────── -->
    <record id="view_commission_settlement_list" model="ir.ui.view">
        <field name="name">commission.settlement.list</field>
        <field name="model">commission.settlement</field>
        <field name="arch" type="xml">
            <list string="Settlements"
                  decoration-success="state == 'paid'"
                  decoration-warning="state in ('submitted','approved','finance_approved')"
                  decoration-danger="state == 'disputed'"
                  decoration-info="state == 'calculated'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="period_id"/>
                <field name="plan_id"/>
                <field name="gross_commission" sum="Gross" string="Gross"/>
                <field name="total_adjustments" sum="Adj." string="Adjustments"/>
                <field name="total_commission" sum="Net" string="Net Commission"/>
                <field name="currency_id" invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'paid'"
                       decoration-warning="state in ('submitted','approved')"
                       decoration-danger="state == 'disputed'"
                       decoration-info="state in ('calculated','finance_approved')"/>
                <field name="anomaly_flag" widget="boolean" string="⚠"/>
                <field name="payment_date"/>
            </list>
        </field>
    </record>

    <!-- ── Kanban ──────────────────────────────────────────────────────────── -->
    <record id="view_commission_settlement_kanban" model="ir.ui.view">
        <field name="name">commission.settlement.kanban</field>
        <field name="model">commission.settlement</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="period_id"/>
                <field name="total_commission"/>
                <field name="currency_id"/>
                <field name="state"/>
                <field name="anomaly_flag"/>
                <field name="line_count"/>
                <progressbar field="state"
                             colors='{"draft": "200", "calculated": "info", "submitted": "primary", "approved": "success", "paid": "success", "disputed": "danger"}'/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_card #{record.anomaly_flag.raw_value ? 'border-warning' : ''}">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="employee_id"/></strong>
                                    <span class="o_kanban_record_subtitle"><field name="period_id"/></span>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div class="row">
                                    <div class="col-8"><field name="plan_id"/></div>
                                    <div class="col-4 text-right">
                                        <strong><field name="total_commission" widget="monetary"/></strong>
                                    </div>
                                </div>
                                <div class="row mt-1">
                                    <div class="col-6 text-muted small"><field name="line_count"/> lines</div>
                                    <div class="col-6 text-right">
                                        <span t-if="record.anomaly_flag.raw_value" class="badge badge-warning">⚠ Anomaly</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ── Form ────────────────────────────────────────────────────────────── -->
    <record id="view_commission_settlement_form" model="ir.ui.view">
        <field name="name">commission.settlement.form</field>
        <field name="model">commission.settlement</field>
        <field name="arch" type="xml">
            <form string="Commission Settlement">
                <header>
                    <button name="action_calculate" type="object" string="Calculate" class="btn-primary"
                            attrs="{'invisible': [('state','!=','draft')]}"/>
                    <button name="action_submit" type="object" string="Submit for Approval" class="btn-primary"
                            attrs="{'invisible': [('state','!=','calculated')]}"/>
                    <button name="action_approve" type="object" string="Approve"
                            groups="advanced_commission_engine.group_commission_manager"
                            attrs="{'invisible': [('state','!=','submitted')]}"/>
                    <button name="action_finance_approve" type="object" string="Finance Approve" class="btn-success"
                            groups="advanced_commission_engine.group_commission_finance_manager"
                            attrs="{'invisible': [('state','!=','approved')]}"/>
                    <button name="action_process_payroll" type="object" string="Process Payroll"
                            groups="advanced_commission_engine.group_commission_hr_manager"
                            attrs="{'invisible': [('state','!=','finance_approved')]}"/>
                    <button name="action_mark_paid" type="object" string="Mark as Paid" class="btn-success"
                            groups="advanced_commission_engine.group_commission_finance_manager"
                            attrs="{'invisible': [('state','!=','payroll_processed')]}"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            groups="advanced_commission_engine.group_commission_manager"
                            attrs="{'invisible': [('state','not in',['calculated','submitted','approved'])]}"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-danger"
                            groups="advanced_commission_engine.group_commission_manager"
                            attrs="{'invisible': [('state','in',['paid','cancelled'])]}"
                            confirm="Cancel this settlement?"/>
                    <button name="action_print_statement" type="object" string="Print Statement" icon="fa-print"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,calculated,submitted,approved,finance_approved,payroll_processed,paid"/>
                </header>
                <sheet>
                    <!-- Anomaly Warning -->
                    <div class="alert alert-warning" role="alert" attrs="{'invisible': [('anomaly_flag','=',False)]}">
                        <strong>⚠ Anomaly Detected:</strong> <field name="anomaly_reason" readonly="1"/>
                    </div>
                    <!-- Smart Buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_lines" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="line_count" widget="statinfo" string="Lines"/>
                        </button>
                        <button name="action_view_adjustments" type="object" class="oe_stat_button" icon="fa-sliders">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><t t-esc="len(record.adjustment_ids)"/></span>
                                <span class="o_stat_text">Adjustments</span>
                            </div>
                        </button>
                        <button name="action_view_disputes" type="object" class="oe_stat_button" icon="fa-exclamation-circle">
                            <field name="dispute_count" widget="statinfo" string="Disputes"/>
                        </button>
                        <button name="action_print_statement" type="object" class="oe_stat_button" icon="fa-file-pdf-o">
                            <span class="o_stat_text">PDF</span>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Settlement">
                            <field name="employee_id" attrs="{'readonly': [('state','!=','draft')]}"/>
                            <field name="period_id" attrs="{'readonly': [('state','!=','draft')]}"/>
                            <field name="plan_id" attrs="{'readonly': [('state','!=','draft')]}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Amounts">
                            <field name="gross_commission" readonly="1"/>
                            <field name="total_adjustments" readonly="1"/>
                            <field name="total_commission" readonly="1" class="o_field_monetary font-weight-bold"/>
                            <field name="clawback_amount" attrs="{'invisible': [('clawback_amount','=',0)]}"/>
                            <field name="hold_amount" attrs="{'invisible': [('hold_amount','=',0)]}"/>
                        </group>
                    </group>
                    <group>
                        <group string="Payout">
                            <field name="payment_date"/>
                            <field name="payslip_id" readonly="1"/>
                            <field name="move_id" readonly="1"/>
                            <field name="is_deferred"/>
                            <field name="split_payout"/>
                            <field name="split_count" attrs="{'invisible': [('split_payout','=',False)]}"/>
                        </group>
                        <group string="Approval">
                            <field name="submitted_by" readonly="1"/>
                            <field name="submitted_at" readonly="1"/>
                            <field name="approved_by_id" readonly="1"/>
                            <field name="approved_at" readonly="1"/>
                            <field name="finance_approved_by" readonly="1"/>
                            <field name="finance_approved_at" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Commission Lines" name="lines">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="source_type"/>
                                    <field name="description"/>
                                    <field name="partner_id"/>
                                    <field name="base_amount" sum="Total Base"/>
                                    <field name="rate" string="Rate %"/>
                                    <field name="commission_amount" sum="Total Commission"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="collection_penalty" sum="Penalties"/>
                                    <field name="is_excluded"/>
                                </list>
                            </field>
                        </page>
                        <page string="Adjustments" name="adjustments">
                            <field name="adjustment_ids"
                                   attrs="{'readonly': [('state','in',['paid','cancelled'])]}">
                                <list>
                                    <field name="name"/>
                                    <field name="adjustment_type"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="date"/>
                                    <field name="state"/>
                                    <field name="reason"/>
                                </list>
                            </field>
                        </page>
                        <page string="Approvals" name="approvals">
                            <field name="approval_ids" readonly="1">
                                <list>
                                    <field name="level"/>
                                    <field name="approver_id"/>
                                    <field name="state" widget="badge"/>
                                    <field name="acted_at"/>
                                    <field name="comments"/>
                                    <field name="deadline"/>
                                </list>
                            </field>
                        </page>
                        <page string="Disputes" name="disputes">
                            <field name="dispute_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="reason"/>
                                    <field name="disputed_amount"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="state" widget="badge"/>
                                    <field name="resolution_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <group>
                                <field name="notes" placeholder="Internal notes..."/>
                                <field name="manager_notes" placeholder="Manager notes..."/>
                                <field name="rejection_reason" readonly="1"
                                       attrs="{'invisible': [('rejection_reason','=',False)]}"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ── My Settlements (employee portal-equivalent in backend) ──────────── -->
    <record id="view_commission_settlement_my_list" model="ir.ui.view">
        <field name="name">commission.settlement.my.list</field>
        <field name="model">commission.settlement</field>
        <field name="inherit_id" ref="view_commission_settlement_list"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="string">My Commission Statements</attribute>
            </list>
        </field>
    </record>

    <!-- ── Actions ─────────────────────────────────────────────────────────── -->
    <record id="action_commission_settlement" model="ir.actions.act_window">
        <field name="name">Settlements</field>
        <field name="res_model">commission.settlement</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_commission_settlement_search"/>
    </record>

    <record id="action_commission_settlement_my" model="ir.actions.act_window">
        <field name="name">My Commission Statements</field>
        <field name="res_model">commission.settlement</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('employee_id.user_id', '=', uid)]</field>
        <field name="context">{'search_default_my_settlements': 1}</field>
        <field name="view_id" ref="view_commission_settlement_my_list"/>
    </record>

</odoo>
