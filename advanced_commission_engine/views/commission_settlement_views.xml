<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_commission_settlement_form" model="ir.ui.view">
        <field name="name">commission.settlement.form</field>
        <field name="model">commission.settlement</field>
        <field name="arch" type="xml">
            <form string="Commission Settlement">
                <header>
                    <button name="action_submit" type="object"
                        string="Submit" class="btn-primary"
                        invisible="state != 'draft'"/>
                    <button name="action_manager_approve" type="object"
                        string="Manager Approve" class="btn-success"
                        invisible="state != 'submitted'"
                        groups="advanced_commission_engine.group_commission_manager"/>
                    <button name="action_finance_approve" type="object"
                        string="Finance Approve" class="btn-success"
                        invisible="state != 'manager_approved'"
                        groups="advanced_commission_engine.group_commission_finance"/>
                    <button name="action_final_approve" type="object"
                        string="Final Approve" class="btn-success"
                        invisible="state != 'finance_approved'"
                        groups="advanced_commission_engine.group_commission_finance"/>
                    <button name="action_pay" type="object"
                        string="Mark as Paid" class="btn-primary"
                        invisible="state != 'approved'"
                        groups="advanced_commission_engine.group_commission_finance"/>
                    <button name="action_reject" type="object"
                        string="Reject"
                        invisible="state in ('draft', 'paid', 'cancelled', 'rejected')"
                        class="btn-danger"
                        groups="advanced_commission_engine.group_commission_manager"/>
                    <button name="action_reset_to_draft" type="object"
                        string="Reset to Draft"
                        invisible="state != 'rejected'"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,submitted,manager_approved,finance_approved,approved,paid"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_move" type="object"
                            class="oe_stat_button" icon="fa-pencil-square-o"
                            invisible="not move_id">
                            <span class="o_stat_text">Journal Entry</span>
                        </button>
                        <button name="action_view_payslip" type="object"
                            class="oe_stat_button" icon="fa-money"
                            invisible="not payslip_id">
                            <span class="o_stat_text">Payslip</span>
                        </button>
                        <button class="oe_stat_button" icon="fa-list-ul">
                            <field name="line_count" widget="statinfo" string="Lines"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Settlement Info">
                            <field name="employee_id" required="1"/>
                            <field name="period_id" required="1"/>
                            <field name="plan_id"/>
                            <field name="date" required="1"/>
                            <field name="settlement_method"/>
                        </group>
                        <group string="Amounts">
                            <field name="gross_commission" readonly="1"/>
                            <field name="adjustment_amount" readonly="1"/>
                            <field name="clawback_amount" readonly="1"/>
                            <field name="net_commission" readonly="1"
                                widget="monetary"
                                class="fw-bold text-success"/>
                            <field name="paid_amount" readonly="1"/>
                            <field name="residual_amount" readonly="1"/>
                        </group>
                    </group>
                    <group invisible="not is_deferred">
                        <field name="is_deferred"/>
                        <field name="deferred_release_date" invisible="not is_deferred"/>
                    </group>
                    <notebook>
                        <page name="lines" string="Commission Lines">
                            <field name="line_ids"
                                context="{'default_employee_id': employee_id, 'default_period_id': period_id, 'default_plan_id': plan_id}">
                                <list decoration-muted="state == 'cancelled'"
                                    decoration-success="state == 'paid'"
                                    decoration-info="state == 'validated'">
                                    <field name="name"/>
                                    <field name="line_type" widget="badge"/>
                                    <field name="source_type" widget="badge"/>
                                    <field name="date"/>
                                    <field name="base_amount"/>
                                    <field name="rate" string="Rate (%)"/>
                                    <field name="commission_amount"/>
                                    <field name="state" widget="badge"
                                        decoration-success="state == 'paid'"
                                        decoration-warning="state == 'validated'"
                                        decoration-info="state == 'draft'"
                                        decoration-danger="state == 'cancelled'"/>
                                </list>
                            </field>
                        </page>
                        <page name="accounting" string="Accounting">
                            <group>
                                <field name="move_id" readonly="1"/>
                                <field name="vendor_bill_id" readonly="1"/>
                                <field name="payslip_id" readonly="1"/>
                                <field name="analytic_account_id"/>
                            </group>
                        </page>
                        <page name="approval" string="Approval History">
                            <group>
                                <group string="Submission">
                                    <field name="submitted_by" readonly="1"/>
                                    <field name="submitted_date" readonly="1"/>
                                </group>
                                <group string="Manager Approval">
                                    <field name="manager_approved_by" readonly="1"/>
                                    <field name="manager_approved_date" readonly="1"/>
                                </group>
                                <group string="Finance Approval">
                                    <field name="finance_approved_by" readonly="1"/>
                                    <field name="finance_approved_date" readonly="1"/>
                                </group>
                                <group string="Final Approval">
                                    <field name="approved_by" readonly="1"/>
                                    <field name="approved_date" readonly="1"/>
                                </group>
                            </group>
                            <group invisible="not rejection_reason">
                                <field name="rejection_reason" readonly="1"/>
                            </group>
                        </page>
                        <page name="notes" string="Notes">
                            <field name="note" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_commission_settlement_list" model="ir.ui.view">
        <field name="name">commission.settlement.list</field>
        <field name="model">commission.settlement</field>
        <field name="arch" type="xml">
            <list string="Commission Settlements"
                decoration-success="state == 'paid'"
                decoration-info="state in ('submitted', 'manager_approved', 'finance_approved', 'approved')"
                decoration-muted="state in ('cancelled', 'rejected')">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="period_id"/>
                <field name="plan_id"/>
                <field name="date"/>
                <field name="gross_commission"/>
                <field name="net_commission" class="fw-bold"/>
                <field name="settlement_method" widget="badge"/>
                <field name="state" widget="badge"
                    decoration-success="state == 'paid'"
                    decoration-info="state in ('approved', 'finance_approved')"
                    decoration-warning="state in ('submitted', 'manager_approved')"
                    decoration-danger="state in ('cancelled', 'rejected')"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_commission_settlement_search" model="ir.ui.view">
        <field name="name">commission.settlement.search</field>
        <field name="model">commission.settlement</field>
        <field name="arch" type="xml">
            <search string="Commission Settlements">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="period_id"/>
                <field name="plan_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="pending" string="Pending Approval"
                    domain="[('state', 'in', ['submitted', 'manager_approved', 'finance_approved'])]"/>
                <filter name="approved" string="Approved"
                    domain="[('state', '=', 'approved')]"/>
                <filter name="paid" string="Paid" domain="[('state', '=', 'paid')]"/>
                <separator/>
                <group>
                    <filter name="group_employee" string="Employee"
                        context="{'group_by': 'employee_id'}"/>
                    <filter name="group_period" string="Period"
                        context="{'group_by': 'period_id'}"/>
                    <filter name="group_method" string="Settlement Method"
                        context="{'group_by': 'settlement_method'}"/>
                    <filter name="group_state" string="Status"
                        context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_commission_settlement" model="ir.actions.act_window">
        <field name="name">Commission Settlements</field>
        <field name="res_model">commission.settlement</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_commission_settlement_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No settlements yet.
            </p>
            <p>Generate settlements from commission periods once lines are validated.</p>
        </field>
    </record>

</odoo>
