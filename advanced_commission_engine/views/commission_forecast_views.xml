<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_commission_forecast_list" model="ir.ui.view">
        <field name="name">commission.forecast.list</field>
        <field name="model">commission.forecast</field>
        <field name="arch" type="xml">
            <list string="Commission Forecasts"
                  decoration-warning="variance_pct &gt; 30"
                  decoration-info="variance_pct &lt; -20">
                <field name="employee_id"/>
                <field name="plan_id"/>
                <field name="period_id"/>
                <field name="forecast_amount" sum="Forecast"/>
                <field name="forecast_low"/>
                <field name="forecast_high"/>
                <field name="confidence_pct"/>
                <field name="avg_historical"/>
                <field name="variance_pct"/>
                <field name="forecast_method"/>
                <field name="last_computed"/>
            </list>
        </field>
    </record>

    <record id="view_commission_forecast_form" model="ir.ui.view">
        <field name="name">commission.forecast.form</field>
        <field name="model">commission.forecast</field>
        <field name="arch" type="xml">
            <form string="Commission Forecast">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="plan_id"/>
                            <field name="period_id"/>
                            <field name="forecast_method"/>
                        </group>
                        <group string="Forecast Amounts">
                            <field name="forecast_amount" widget="monetary"/>
                            <field name="forecast_low" widget="monetary"/>
                            <field name="forecast_high" widget="monetary"/>
                            <field name="confidence_pct"/>
                        </group>
                        <group string="Historical Basis">
                            <field name="avg_historical" widget="monetary"/>
                            <field name="months_history_used"/>
                            <field name="variance_pct"/>
                            <field name="last_computed" readonly="1"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_commission_forecast_graph" model="ir.ui.view">
        <field name="name">commission.forecast.graph</field>
        <field name="model">commission.forecast</field>
        <field name="arch" type="xml">
            <graph string="Commission Forecasts" type="bar">
                <field name="period_id" type="row"/>
                <field name="forecast_amount" type="measure"/>
                <field name="avg_historical" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_commission_forecast" model="ir.actions.act_window">
        <field name="name">Commission Forecasts</field>
        <field name="res_model">commission.forecast</field>
        <field name="view_mode">list,graph,form</field>
    </record>
</odoo>
