<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_commission_forecast_search" model="ir.ui.view">
        <field name="name">commission.forecast.search</field>
        <field name="model">commission.forecast</field>
        <field name="arch" type="xml">
            <search string="Commission Forecasts">
                <field name="employee_id"/>
                <field name="period_id"/>
                <field name="plan_id"/>
                <field name="method"/>
                <filter string="Stale" name="stale" domain="[('is_stale','=',True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Period" name="group_period" context="{'group_by': 'period_id'}"/>
                    <filter string="Method" name="group_method" context="{'group_by': 'method'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_commission_forecast_list" model="ir.ui.view">
        <field name="name">commission.forecast.list</field>
        <field name="model">commission.forecast</field>
        <field name="arch" type="xml">
            <list string="Commission Forecasts"
                  decoration-warning="is_stale">
                <field name="employee_id"/>
                <field name="period_id"/>
                <field name="plan_id"/>
                <field name="method"/>
                <field name="forecast_low" sum="Low" string="Pessimistic"/>
                <field name="forecast_amount" sum="Mid" string="Forecast"/>
                <field name="forecast_high" sum="High" string="Optimistic"/>
                <field name="confidence_pct" string="Confidence %"/>
                <field name="currency_id" invisible="1"/>
                <field name="actual_commission" sum="Actual"/>
                <field name="variance_pct" string="Variance %"/>
                <field name="computed_at" string="Last Run"/>
                <field name="is_stale" invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_commission_forecast_form" model="ir.ui.view">
        <field name="name">commission.forecast.form</field>
        <field name="model">commission.forecast</field>
        <field name="arch" type="xml">
            <form string="Commission Forecast">
                <header>
                    <button name="action_recompute" type="object" string="Recompute" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" attrs="{'invisible': [('is_stale','=',False)]}">
                        ⚠ This forecast is stale (older than 7 days). Click Recompute to refresh.
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Scope">
                            <field name="employee_id"/>
                            <field name="period_id"/>
                            <field name="plan_id"/>
                            <field name="method"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Forecast">
                            <field name="forecast_low" string="Pessimistic"/>
                            <field name="forecast_amount" string="Base Forecast" class="font-weight-bold"/>
                            <field name="forecast_high" string="Optimistic"/>
                            <field name="confidence_pct"/>
                        </group>
                    </group>
                    <group>
                        <group string="Basis">
                            <field name="historical_avg"/>
                            <field name="pipeline_value"/>
                            <field name="target_amount"/>
                            <field name="periods_used"/>
                            <field name="computed_at"/>
                        </group>
                        <group string="Vs Actual">
                            <field name="actual_commission"/>
                            <field name="variance"/>
                            <field name="variance_pct" string="Variance %"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Analyst notes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_commission_forecast_graph" model="ir.ui.view">
        <field name="name">commission.forecast.graph</field>
        <field name="model">commission.forecast</field>
        <field name="arch" type="xml">
            <graph string="Forecast vs Actual" type="bar">
                <field name="employee_id" type="row"/>
                <field name="forecast_amount" type="measure" string="Forecast"/>
                <field name="actual_commission" type="measure" string="Actual"/>
            </graph>
        </field>
    </record>

    <record id="action_commission_forecast" model="ir.actions.act_window">
        <field name="name">Commission Forecasts</field>
        <field name="res_model">commission.forecast</field>
        <field name="view_mode">list,form,graph</field>
    </record>

</odoo>
