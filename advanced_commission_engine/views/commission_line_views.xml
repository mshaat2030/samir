<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_commission_line_form" model="ir.ui.view">
        <field name="name">commission.line.form</field>
        <field name="model">commission.line</field>
        <field name="arch" type="xml">
            <form string="Commission Line">
                <header>
                    <button name="action_validate" type="object"
                        string="Validate"
                        class="btn-primary"
                        invisible="state != 'draft'"
                        groups="advanced_commission_engine.group_commission_manager"/>
                    <button name="action_cancel" type="object"
                        string="Cancel"
                        invisible="state in ('paid', 'cancelled')"
                        class="btn-danger"
                        groups="advanced_commission_engine.group_commission_manager"/>
                    <button name="action_dispute" type="object"
                        string="Raise Dispute"
                        invisible="state == 'cancelled'"/>
                    <button name="action_create_clawback" type="object"
                        string="Clawback"
                        invisible="state != 'paid' or is_clawback"
                        groups="advanced_commission_engine.group_commission_finance"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,validated,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Description..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" required="1"/>
                            <field name="period_id" required="1"/>
                            <field name="plan_id" required="1"/>
                            <field name="rule_id"/>
                            <field name="date" required="1"/>
                        </group>
                        <group>
                            <field name="line_type" widget="badge"/>
                            <field name="source_type" widget="badge"/>
                            <field name="base_amount"/>
                            <field name="rate" string="Rate (%)"/>
                            <field name="commission_amount"/>
                            <field name="margin_amount"/>
                        </group>
                    </group>
                    <group string="Source Document">
                        <field name="sale_order_id"
                            invisible="source_type != 'sale_order'"/>
                        <field name="invoice_id"
                            invisible="source_type != 'invoice'"/>
                        <field name="payment_id"
                            invisible="source_type != 'payment'"/>
                    </group>
                    <group string="Split" invisible="not is_split">
                        <field name="is_split"/>
                        <field name="split_percent" invisible="not is_split"/>
                        <field name="parent_line_id" invisible="not is_split"/>
                    </group>
                    <group string="Clawback" invisible="not is_clawback">
                        <field name="is_clawback"/>
                        <field name="original_line_id" invisible="not is_clawback"/>
                        <field name="clawback_reason" invisible="not is_clawback"/>
                    </group>
                    <group string="Deferred" invisible="not is_deferred">
                        <field name="is_deferred"/>
                        <field name="deferred_until" invisible="not is_deferred"/>
                    </group>
                    <field name="note" placeholder="Internal notes..."/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_commission_line_list" model="ir.ui.view">
        <field name="name">commission.line.list</field>
        <field name="model">commission.line</field>
        <field name="arch" type="xml">
            <list string="Commission Lines"
                decoration-success="state == 'paid'"
                decoration-info="state == 'validated'"
                decoration-muted="state == 'cancelled'"
                decoration-danger="state == 'disputed'">
                <field name="date"/>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="period_id"/>
                <field name="plan_id"/>
                <field name="line_type" widget="badge"
                    decoration-success="line_type == 'commission'"
                    decoration-warning="line_type == 'adjustment'"
                    decoration-danger="line_type in ('clawback', 'deduction')"/>
                <field name="source_type"/>
                <field name="base_amount"/>
                <field name="rate" string="Rate (%)"/>
                <field name="commission_amount" sum="Total Commission"/>
                <field name="state" widget="badge"
                    decoration-success="state == 'paid'"
                    decoration-info="state == 'validated'"
                    decoration-warning="state == 'draft'"
                    decoration-danger="state == 'cancelled'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_commission_line_search" model="ir.ui.view">
        <field name="name">commission.line.search</field>
        <field name="model">commission.line</field>
        <field name="arch" type="xml">
            <search string="Commission Lines">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="period_id"/>
                <field name="plan_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="validated" string="Validated" domain="[('state', '=', 'validated')]"/>
                <filter name="paid" string="Paid" domain="[('state', '=', 'paid')]"/>
                <filter name="commissions" string="Commissions" domain="[('line_type', '=', 'commission')]"/>
                <filter name="adjustments" string="Adjustments" domain="[('line_type', '=', 'adjustment')]"/>
                <filter name="clawbacks" string="Clawbacks" domain="[('line_type', '=', 'clawback')]"/>
                <separator/>
                <filter name="this_month" string="This Month"
                    domain="[('date', '>=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <group>
                    <filter name="group_employee" string="Employee"
                        context="{'group_by': 'employee_id'}"/>
                    <filter name="group_period" string="Period"
                        context="{'group_by': 'period_id'}"/>
                    <filter name="group_plan" string="Plan"
                        context="{'group_by': 'plan_id'}"/>
                    <filter name="group_type" string="Type"
                        context="{'group_by': 'line_type'}"/>
                    <filter name="group_month" string="Month"
                        context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_commission_line" model="ir.actions.act_window">
        <field name="name">Commission Lines</field>
        <field name="res_model">commission.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_commission_line_search"/>
    </record>

</odoo>
