<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dashboard client action -->
    <record id="action_commission_dashboard" model="ir.actions.client">
        <field name="name">Commission Dashboard</field>
        <field name="tag">commission_dashboard</field>
    </record>

    <!-- Leaderboard views -->
    <record id="view_commission_leaderboard_list" model="ir.ui.view">
        <field name="name">commission.leaderboard.list</field>
        <field name="model">commission.leaderboard</field>
        <field name="arch" type="xml">
            <list string="Leaderboard" default_order="rank asc">
                <field name="rank"/>
                <field name="rank_change_icon" string="↕"/>
                <field name="employee_id"/>
                <field name="period_id"/>
                <field name="plan_id"/>
                <field name="total_commission" sum="Total Commission"/>
                <field name="total_base_amount" sum="Total Revenue"/>
                <field name="line_count"/>
                <field name="target_attainment" widget="progressbar"/>
                <field name="streak"/>
                <field name="badge_count"/>
            </list>
        </field>
    </record>

    <record id="view_commission_leaderboard_search" model="ir.ui.view">
        <field name="name">commission.leaderboard.search</field>
        <field name="model">commission.leaderboard</field>
        <field name="arch" type="xml">
            <search string="Leaderboard">
                <field name="employee_id"/>
                <field name="period_id"/>
                <field name="plan_id"/>
                <group>
                    <filter string="Period" name="groupby_period" context="{'group_by':'period_id'}"/>
                    <filter string="Plan" name="groupby_plan" context="{'group_by':'plan_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_commission_leaderboard" model="ir.actions.act_window">
        <field name="name">Commission Leaderboard</field>
        <field name="res_model">commission.leaderboard</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_groupby_period': 1}</field>
    </record>

    <!-- Badge views -->
    <record id="view_commission_badge_list" model="ir.ui.view">
        <field name="name">commission.badge.list</field>
        <field name="model">commission.badge</field>
        <field name="arch" type="xml">
            <list string="Badges" editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="badge_type"/>
                <field name="criteria_type"/>
                <field name="criteria_value"/>
                <field name="points"/>
                <field name="award_count" string="Times Awarded" readonly="1"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_commission_badge_form" model="ir.ui.view">
        <field name="name">commission.badge.form</field>
        <field name="model">commission.badge</field>
        <field name="arch" type="xml">
            <form string="Commission Badge">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_award_count"
                                class="oe_stat_button" icon="fa-trophy">
                            <field name="award_count" string="Awards" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <i class="fa fa-trophy me-2 text-warning"/>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="badge_type"/>
                            <field name="icon"/>
                            <field name="color" widget="color_picker"/>
                            <field name="points"/>
                            <field name="active"/>
                        </group>
                        <group string="Award Criteria">
                            <field name="criteria_type"/>
                            <field name="criteria_value"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Badge description..."/>
                    <separator string="Award History"/>
                    <field name="award_ids" readonly="1">
                        <list>
                            <field name="employee_id"/>
                            <field name="period_id"/>
                            <field name="date_awarded"/>
                            <field name="awarded_by_id"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_commission_badge" model="ir.actions.act_window">
        <field name="name">Commission Badges</field>
        <field name="res_model">commission.badge</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
