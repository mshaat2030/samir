<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══ OWL Dashboard Client Action ══════════════════════════════════ -->
    <record id="action_commission_dashboard" model="ir.actions.client">
        <field name="name">Commission Dashboard</field>
        <field name="tag">commission_dashboard</field>
        <field name="context">{}</field>
    </record>

    <!-- ═══ Commission Analytics Graph View ══════════════════════════════ -->
    <record id="view_commission_line_graph" model="ir.ui.view">
        <field name="name">commission.line.graph</field>
        <field name="model">commission.line</field>
        <field name="arch" type="xml">
            <graph string="Commission Analytics" type="bar" sample="1">
                <field name="period_id" type="row"/>
                <field name="employee_id" type="row"/>
                <field name="commission_amount" type="measure"/>
                <field name="base_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ═══ Commission Analytics Pivot View ══════════════════════════════ -->
    <record id="view_commission_line_pivot" model="ir.ui.view">
        <field name="name">commission.line.pivot</field>
        <field name="model">commission.line</field>
        <field name="arch" type="xml">
            <pivot string="Commission Analytics" sample="1" display_quantity="1">
                <field name="period_id" type="row"/>
                <field name="employee_id" type="row"/>
                <field name="plan_id" type="col"/>
                <field name="commission_amount" type="measure"/>
                <field name="base_amount" type="measure"/>
                <field name="margin_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ═══ Commission Analytics Action ══════════════════════════════════ -->
    <record id="action_commission_analytics" model="ir.actions.act_window">
        <field name="name">Commission Analytics</field>
        <field name="res_model">commission.line</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="domain">[('line_type', '=', 'commission'), ('state', '!=', 'cancelled')]</field>
        <field name="context">{'search_default_commissions': 1}</field>
    </record>

    <!-- ═══ Settlement Summary Pivot ═════════════════════════════════════ -->
    <record id="view_commission_settlement_pivot" model="ir.ui.view">
        <field name="name">commission.settlement.pivot</field>
        <field name="model">commission.settlement</field>
        <field name="arch" type="xml">
            <pivot string="Settlement Summary" sample="1">
                <field name="period_id" type="row"/>
                <field name="department_id" type="row"/>
                <field name="settlement_method" type="col"/>
                <field name="net_commission" type="measure"/>
                <field name="gross_commission" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_commission_settlement_pivot" model="ir.actions.act_window">
        <field name="name">Settlement Analytics</field>
        <field name="res_model">commission.settlement</field>
        <field name="view_mode">pivot,graph,list</field>
    </record>

</odoo>
