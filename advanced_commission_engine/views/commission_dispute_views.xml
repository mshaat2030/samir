<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_commission_dispute_form" model="ir.ui.view">
        <field name="name">commission.dispute.form</field>
        <field name="model">commission.dispute</field>
        <field name="arch" type="xml">
            <form string="Commission Dispute">
                <header>
                    <button name="action_start_review" type="object"
                        string="Start Review"
                        class="btn-primary"
                        invisible="state != 'open'"
                        groups="advanced_commission_engine.group_commission_manager"/>
                    <button name="action_accept" type="object"
                        string="Accept"
                        class="btn-success"
                        invisible="state not in ('open', 'under_review')"
                        groups="advanced_commission_engine.group_commission_manager"/>
                    <button name="action_partial_accept" type="object"
                        string="Partial Accept"
                        invisible="state not in ('open', 'under_review')"
                        groups="advanced_commission_engine.group_commission_manager"/>
                    <button name="action_reject" type="object"
                        string="Reject"
                        class="btn-danger"
                        invisible="state not in ('open', 'under_review')"
                        groups="advanced_commission_engine.group_commission_manager"/>
                    <button name="action_escalate" type="object"
                        string="Escalate"
                        invisible="state not in ('open', 'under_review')"
                        groups="advanced_commission_engine.group_commission_manager"/>
                    <button name="action_close" type="object"
                        string="Close"
                        invisible="state not in ('resolved_accepted', 'resolved_rejected', 'resolved_partial', 'escalated')"
                        groups="advanced_commission_engine.group_commission_manager"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="open,under_review,resolved_accepted,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-balance-scale"
                            invisible="not adjustment_id" type="object" name="action_close">
                            <span class="o_stat_text">Adjustment Created</span>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Urgent" bg_color="text-bg-danger"
                        invisible="priority != '3'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Dispute Details">
                            <field name="employee_id" required="1"/>
                            <field name="date" required="1"/>
                            <field name="deadline"/>
                            <field name="dispute_type"/>
                            <field name="priority" widget="priority"/>
                        </group>
                        <group string="Amounts">
                            <field name="current_amount" readonly="1"/>
                            <field name="claimed_amount"/>
                            <field name="difference" readonly="1" class="fw-bold"/>
                            <field name="resolved_amount"
                                invisible="state not in ('resolved_partial',)"/>
                        </group>
                    </group>
                    <group string="Related Documents">
                        <field name="settlement_id"/>
                        <field name="line_id"/>
                    </group>
                    <group string="Employee Statement">
                        <field name="description" required="1"
                            placeholder="Describe the dispute in detail..."/>
                        <field name="supporting_docs" widget="binary"
                            filename="supporting_docs_name"/>
                    </group>
                    <group string="Resolution" invisible="state == 'open'">
                        <field name="reviewer_id" readonly="1"/>
                        <field name="reviewed_date" readonly="1"/>
                        <field name="resolution_notes"
                            placeholder="Resolution notes..."
                            invisible="state == 'open'"/>
                        <field name="adjustment_id" readonly="1"
                            invisible="not adjustment_id"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_commission_dispute_list" model="ir.ui.view">
        <field name="name">commission.dispute.list</field>
        <field name="model">commission.dispute</field>
        <field name="arch" type="xml">
            <list string="Commission Disputes"
                decoration-danger="state == 'escalated' or priority == '3'"
                decoration-success="state in ('resolved_accepted',)"
                decoration-muted="state == 'closed'">
                <field name="priority" widget="priority"/>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="date"/>
                <field name="deadline"/>
                <field name="dispute_type" widget="badge"/>
                <field name="current_amount"/>
                <field name="claimed_amount"/>
                <field name="difference" class="fw-bold"/>
                <field name="reviewer_id"/>
                <field name="state" widget="badge"
                    decoration-info="state == 'open'"
                    decoration-warning="state == 'under_review'"
                    decoration-success="state in ('resolved_accepted', 'resolved_partial')"
                    decoration-danger="state in ('escalated', 'resolved_rejected')"/>
            </list>
        </field>
    </record>

    <record id="view_commission_dispute_search" model="ir.ui.view">
        <field name="name">commission.dispute.search</field>
        <field name="model">commission.dispute</field>
        <field name="arch" type="xml">
            <search string="Commission Disputes">
                <field name="name"/>
                <field name="employee_id"/>
                <filter name="open" string="Open" domain="[('state', '=', 'open')]"/>
                <filter name="under_review" string="Under Review"
                    domain="[('state', '=', 'under_review')]"/>
                <filter name="resolved" string="Resolved"
                    domain="[('state', 'in', ['resolved_accepted', 'resolved_rejected', 'resolved_partial'])]"/>
                <filter name="escalated" string="Escalated"
                    domain="[('state', '=', 'escalated')]"/>
                <filter name="urgent" string="Urgent" domain="[('priority', '=', '3')]"/>
                <separator/>
                <group>
                    <filter name="group_employee" string="Employee"
                        context="{'group_by': 'employee_id'}"/>
                    <filter name="group_type" string="Dispute Type"
                        context="{'group_by': 'dispute_type'}"/>
                    <filter name="group_state" string="Status"
                        context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_commission_dispute" model="ir.actions.act_window">
        <field name="name">Commission Disputes</field>
        <field name="res_model">commission.dispute</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_commission_dispute_search"/>
        <field name="context">{'search_default_open': 1}</field>
    </record>

</odoo>
