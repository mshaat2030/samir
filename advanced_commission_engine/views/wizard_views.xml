<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══ Settlement Wizard ════════════════════════════════════════════ -->
    <record id="view_commission_settlement_wizard_form" model="ir.ui.view">
        <field name="name">commission.settlement.wizard.form</field>
        <field name="model">commission.settlement.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Commission Settlements">
                <sheet>
                    <group>
                        <group>
                            <field name="period_id" required="1"/>
                            <field name="settlement_method"/>
                            <field name="plan_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="include_adjustments"/>
                            <field name="auto_submit"/>
                            <field name="dry_run"/>
                        </group>
                    </group>
                    <separator string="Preview" invisible="not preview_line_ids"/>
                    <field name="preview_line_ids" readonly="1"
                        invisible="not preview_line_ids">
                        <list>
                            <field name="employee_id"/>
                            <field name="plan_id"/>
                            <field name="line_count"/>
                            <field name="total_amount"/>
                        </list>
                    </field>
                    <div class="alert alert-info" role="status" invisible="not result_message">
                        <field name="result_message" readonly="1"/>
                    </div>
                </sheet>
                <footer>
                    <button name="action_preview" type="object"
                        string="Preview" class="btn-secondary"/>
                    <button name="action_generate" type="object"
                        string="Generate Settlements" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_commission_settlement_wizard" model="ir.actions.act_window">
        <field name="name">Generate Settlements</field>
        <field name="res_model">commission.settlement.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ═══ Recalculate Wizard ═══════════════════════════════════════════ -->
    <record id="view_commission_recalculate_wizard_form" model="ir.ui.view">
        <field name="name">commission.recalculate.wizard.form</field>
        <field name="model">commission.recalculate.wizard</field>
        <field name="arch" type="xml">
            <form string="Recalculate Commissions">
                <sheet>
                    <group>
                        <field name="recalc_type" widget="radio"/>
                        <field name="period_id"
                            invisible="recalc_type != 'period'"/>
                        <field name="employee_ids"
                            invisible="recalc_type != 'employee'"
                            widget="many2many_tags"/>
                        <field name="plan_ids"
                            invisible="recalc_type != 'plan'"
                            widget="many2many_tags"/>
                        <field name="line_ids"
                            invisible="recalc_type != 'selection'"
                            widget="many2many_tags"/>
                        <field name="create_adjustments"/>
                        <field name="reason" required="1"
                            placeholder="Reason for recalculation..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_recalculate" type="object"
                        string="Recalculate" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_commission_recalculate_wizard" model="ir.actions.act_window">
        <field name="name">Recalculate Commissions</field>
        <field name="res_model">commission.recalculate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ═══ Period Generate Wizard ════════════════════════════════════════ -->
    <record id="view_commission_period_generate_wizard_form" model="ir.ui.view">
        <field name="name">commission.period.generate.wizard.form</field>
        <field name="model">commission.period.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Commission Periods">
                <sheet>
                    <group>
                        <field name="year"/>
                        <field name="period_type"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="plan_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate" type="object"
                        string="Generate Periods" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_commission_period_generate_wizard" model="ir.actions.act_window">
        <field name="name">Generate Periods</field>
        <field name="res_model">commission.period.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ═══ Simulation Wizard ═════════════════════════════════════════════ -->
    <record id="view_commission_simulation_wizard_form" model="ir.ui.view">
        <field name="name">commission.simulation.wizard.form</field>
        <field name="model">commission.simulation.wizard</field>
        <field name="arch" type="xml">
            <form string="Quick Commission Simulation">
                <sheet>
                    <group>
                        <field name="plan_id" required="1"/>
                        <field name="employee_id"/>
                        <field name="base_amount" required="1"/>
                        <field name="margin_percent"/>
                        <field name="achieved_percent"/>
                        <field name="run_scenarios"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_simulate" type="object"
                        string="Simulate" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_commission_simulation_wizard" model="ir.actions.act_window">
        <field name="name">Quick Simulation</field>
        <field name="res_model">commission.simulation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
