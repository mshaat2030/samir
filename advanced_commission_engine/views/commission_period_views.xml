<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_commission_period_form" model="ir.ui.view">
        <field name="name">commission.period.form</field>
        <field name="model">commission.period</field>
        <field name="arch" type="xml">
            <form string="Commission Period">
                <header>
                    <button name="action_submit_approval" type="object"
                        string="Submit for Approval"
                        class="btn-primary"
                        invisible="state != 'open'"
                        groups="advanced_commission_engine.group_commission_manager"/>
                    <button name="action_approve" type="object"
                        string="Approve &amp; Lock"
                        class="btn-success"
                        invisible="state != 'pending_approval'"
                        groups="advanced_commission_engine.group_commission_finance"/>
                    <button name="action_lock" type="object"
                        string="Lock"
                        invisible="state != 'open'"
                        groups="advanced_commission_engine.group_commission_finance"/>
                    <button name="action_unlock" type="object"
                        string="Unlock"
                        invisible="state != 'locked'"
                        groups="advanced_commission_engine.group_commission_finance"/>
                    <button name="action_compute_commissions" type="object"
                        string="Compute Commissions"
                        class="btn-secondary"
                        invisible="state not in ('open', 'pending_approval')"
                        groups="advanced_commission_engine.group_commission_manager"/>
                    <button name="action_cancel" type="object"
                        string="Cancel"
                        invisible="state in ('locked', 'cancelled')"
                        class="btn-danger"
                        confirm="Cancel this period? This cannot be undone easily."
                        groups="advanced_commission_engine.group_commission_finance"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="open,pending_approval,locked"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_settlements" type="object"
                            class="oe_stat_button" icon="fa-check-circle">
                            <field name="settlement_count" widget="statinfo" string="Settlements"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-list-ul"
                            type="object" name="action_view_settlements">
                            <field name="line_count" widget="statinfo" string="Lines"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Period Name..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="period_type"/>
                            <field name="date_from" required="1"/>
                            <field name="date_to" required="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Totals" readonly="1">
                            <field name="total_commission"/>
                            <field name="total_paid"/>
                            <field name="total_pending"/>
                        </group>
                    </group>
                    <group string="Approval">
                        <group>
                            <field name="locked_by" readonly="1"/>
                            <field name="locked_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="approved_by" readonly="1"/>
                            <field name="approved_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="Commission Plans">
                        <field name="plan_ids" nolabel="1" widget="many2many_tags"/>
                    </group>
                    <field name="note" placeholder="Internal notes..."/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_commission_period_list" model="ir.ui.view">
        <field name="name">commission.period.list</field>
        <field name="model">commission.period</field>
        <field name="arch" type="xml">
            <list string="Commission Periods"
                decoration-success="state == 'locked'"
                decoration-info="state == 'open'"
                decoration-warning="state == 'pending_approval'"
                decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="period_type" widget="badge"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="total_commission"/>
                <field name="total_paid"/>
                <field name="settlement_count"/>
                <field name="line_count"/>
                <field name="state" widget="badge"
                    decoration-success="state == 'locked'"
                    decoration-info="state == 'open'"
                    decoration-warning="state == 'pending_approval'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_commission_period_search" model="ir.ui.view">
        <field name="name">commission.period.search</field>
        <field name="model">commission.period</field>
        <field name="arch" type="xml">
            <search string="Commission Periods">
                <field name="name"/>
                <filter name="open" string="Open" domain="[('state', '=', 'open')]"/>
                <filter name="locked" string="Locked" domain="[('state', '=', 'locked')]"/>
                <filter name="pending" string="Pending Approval"
                    domain="[('state', '=', 'pending_approval')]"/>
                <separator/>
                <group>
                    <filter name="group_type" string="Period Type"
                        context="{'group_by': 'period_type'}"/>
                    <filter name="group_year" string="Year"
                        context="{'group_by': 'date_from:year'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_commission_period" model="ir.actions.act_window">
        <field name="name">Commission Periods</field>
        <field name="res_model">commission.period</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_commission_period_search"/>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first commission period!
            </p>
            <p>
                Periods define the time windows for commission calculation and settlement.
            </p>
        </field>
    </record>

</odoo>
