<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_commission_period_form" model="ir.ui.view">
        <field name="name">commission.period.form</field>
        <field name="model">commission.period</field>
        <field name="arch" type="xml">
            <form string="Commission Period">
                <header>
                    <button name="action_lock" string="Lock Period" type="object"
                            class="btn-warning" invisible="state != 'open'"
                            confirm="Locking the period will prevent new commission lines. Continue?"/>
                    <button name="action_unlock" string="Unlock" type="object"
                            invisible="state != 'locked'"
                            groups="advanced_commission_engine.group_commission_finance_manager"/>
                    <button name="action_freeze" string="Freeze Period" type="object"
                            class="btn-danger" invisible="state != 'locked'"
                            confirm="Freezing is permanent unless reopened by Finance. Continue?"/>
                    <button name="action_reopen" string="Reopen" type="object"
                            invisible="state != 'frozen'"
                            groups="advanced_commission_engine.group_commission_finance_manager"/>
                    <button name="action_generate_settlements" string="Generate Settlements"
                            type="object" class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,locked,frozen"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_settlements" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <field name="settlement_count" string="Settlements" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Period Name..."/></h1>
                        <div class="text-muted"><field name="code" readonly="1"/></div>
                    </div>
                    <group>
                        <group>
                            <field name="period_type"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Summary">
                            <field name="total_commission" widget="monetary"/>
                            <field name="paid_commission" widget="monetary"/>
                            <field name="auto_created" readonly="1"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_commission_period_list" model="ir.ui.view">
        <field name="name">commission.period.list</field>
        <field name="model">commission.period</field>
        <field name="arch" type="xml">
            <list string="Commission Periods" decoration-muted="state == 'frozen'">
                <field name="name"/>
                <field name="code"/>
                <field name="period_type"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="settlement_count"/>
                <field name="total_commission" sum="Total Commission"/>
                <field name="paid_commission" sum="Total Paid"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'open'"
                       decoration-warning="state == 'locked'"
                       decoration-danger="state == 'frozen'"/>
            </list>
        </field>
    </record>

    <record id="view_commission_period_search" model="ir.ui.view">
        <field name="name">commission.period.search</field>
        <field name="model">commission.period</field>
        <field name="arch" type="xml">
            <search string="Search Periods">
                <field name="name"/>
                <filter string="Open" name="open" domain="[('state','=','open')]"/>
                <filter string="Locked" name="locked" domain="[('state','=','locked')]"/>
                <filter string="Frozen" name="frozen" domain="[('state','=','frozen')]"/>
                <separator/>
                <filter string="This Month" name="this_month"
                        domain="[('date_start','&lt;=',(context_today()).strftime('%%Y-%%m-%%d')), ('date_end','&gt;=',(context_today()).strftime('%%Y-%%m-%%d'))]"/>
                <group>
                    <filter string="Period Type" name="groupby_type" context="{'group_by':'period_type'}"/>
                    <filter string="State" name="groupby_state" context="{'group_by':'state'}"/>
                    <filter string="Year" name="groupby_year" context="{'group_by':'date_start:year'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_commission_period" model="ir.actions.act_window">
        <field name="name">Commission Periods</field>
        <field name="res_model">commission.period</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>
</odoo>
