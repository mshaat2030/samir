<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="contract_management.Dashboard">
<div class="cm_dash">

    <!-- ══════════════════ LOADING ══════════════════ -->
    <t t-if="state.loading">
        <div class="cm_dash_loader">
            <div class="cm_spinner_wrap">
                <div class="cm_spinner"/>
                <p class="cm_spinner_text">Loading dashboard…</p>
            </div>
        </div>
    </t>

    <!-- ══════════════════ ERROR ══════════════════ -->
    <t t-elif="state.error">
        <div class="cm_dash_error">
            <div class="cm_error_box">
                <i class="fa fa-exclamation-triangle cm_error_icon"/>
                <h3>Unable to load dashboard</h3>
                <p t-esc="state.error"/>
                <button class="cm_btn cm_btn_primary" t-on-click="_loadData">
                    <i class="fa fa-refresh me-1"/> Retry
                </button>
            </div>
        </div>
    </t>

    <!-- ══════════════════ MAIN ══════════════════ -->
    <t t-else="">

        <!-- ── Hero header ─────────────────────────────────────────── -->
        <div class="cm_hero">
            <div class="cm_hero_inner">
                <div class="cm_hero_left">
                    <div class="cm_hero_icon">
                        <i class="fa fa-file-text"/>
                    </div>
                    <div>
                        <h1 class="cm_hero_title">Contract Dashboard</h1>
                        <p class="cm_hero_sub">
                            <i class="fa fa-circle cm_hero_dot"/> Real-time overview
                            <span class="cm_hero_sep">·</span>
                            <i class="fa fa-magic"/> AI-powered insights
                        </p>
                    </div>
                </div>
                <div class="cm_hero_right">
                    <div t-attf-class="cm_health_pill {{ healthColor }}">
                        <i class="fa fa-heartbeat cm_health_beat"/>
                        <span class="cm_health_pct" t-esc="healthPct + '%'"/>
                        <span class="cm_health_lbl" t-esc="healthLabel"/>
                    </div>
                    <button class="cm_btn cm_btn_ghost" t-on-click="_loadData">
                        <i class="fa fa-refresh"/> Refresh
                    </button>
                </div>
            </div>
        </div>

        <!-- ── Quick Actions bar ─────────────────────────────────── -->
        <div class="cm_actions_bar">
            <div class="cm_actions_inner">
                <span class="cm_actions_label">
                    <i class="fa fa-bolt me-1"/> Quick Actions
                </span>
                <div class="cm_actions_btns">
                    <button class="cm_qa_btn cm_qa_primary" t-on-click="createContract">
                        <i class="fa fa-plus-circle"/> New Contract
                    </button>
                    <button class="cm_qa_btn cm_qa_outline" t-on-click="openTemplates">
                        <i class="fa fa-copy"/> Templates
                    </button>
                    <button class="cm_qa_btn cm_qa_outline" t-on-click="openAllContracts">
                        <i class="fa fa-list"/> All Contracts
                    </button>
                    <button t-if="state.data.kpi.expiring_30 > 0"
                            class="cm_qa_btn cm_qa_warn" t-on-click="openExpiringSoon">
                        <i class="fa fa-clock-o"/>
                        <t t-esc="state.data.kpi.expiring_30"/> Expiring Soon
                    </button>
                </div>
            </div>
        </div>

        <!-- ── KPI strip ──────────────────────────────────────────── -->
        <div class="cm_kpi_strip">

            <div class="cm_kpi cm_kpi_total" t-on-click="openAllContracts">
                <div class="cm_kpi_icon_wrap">
                    <i class="fa fa-file-text-o"/>
                </div>
                <div class="cm_kpi_body">
                    <span class="cm_kpi_num" t-esc="state.data.kpi.total"/>
                    <span class="cm_kpi_lbl">Total</span>
                </div>
                <i class="fa fa-chevron-right cm_kpi_arrow"/>
            </div>

            <div class="cm_kpi cm_kpi_active" t-on-click="openActive">
                <div class="cm_kpi_icon_wrap">
                    <i class="fa fa-check-circle"/>
                </div>
                <div class="cm_kpi_body">
                    <span class="cm_kpi_num" t-esc="state.data.kpi.active"/>
                    <span class="cm_kpi_lbl">Active</span>
                </div>
                <i class="fa fa-chevron-right cm_kpi_arrow"/>
            </div>

            <div class="cm_kpi cm_kpi_draft" t-on-click="openDraft">
                <div class="cm_kpi_icon_wrap">
                    <i class="fa fa-pencil-square-o"/>
                </div>
                <div class="cm_kpi_body">
                    <span class="cm_kpi_num" t-esc="state.data.kpi.draft"/>
                    <span class="cm_kpi_lbl">Draft</span>
                </div>
                <i class="fa fa-chevron-right cm_kpi_arrow"/>
            </div>

            <div class="cm_kpi cm_kpi_closed" t-on-click="openClosedContracts">
                <div class="cm_kpi_icon_wrap">
                    <i class="fa fa-ban"/>
                </div>
                <div class="cm_kpi_body">
                    <span class="cm_kpi_num"
                          t-esc="state.data.kpi.expired + state.data.kpi.cancelled"/>
                    <span class="cm_kpi_lbl">Expired / Cancelled</span>
                </div>
                <i class="fa fa-chevron-right cm_kpi_arrow"/>
            </div>

            <div class="cm_kpi cm_kpi_expiring" t-on-click="openExpiringSoon">
                <div class="cm_kpi_icon_wrap">
                    <i class="fa fa-clock-o"/>
                </div>
                <div class="cm_kpi_body">
                    <span class="cm_kpi_num" t-esc="state.data.kpi.expiring_30"/>
                    <span class="cm_kpi_lbl">Expiring ≤ 30 days</span>
                </div>
                <i class="fa fa-chevron-right cm_kpi_arrow"/>
            </div>

        </div><!-- /kpi_strip -->

        <!-- ── Two-column grid ───────────────────────────────────── -->
        <div class="cm_grid">

            <!-- ════════ LEFT COLUMN ════════ -->
            <div class="cm_col">

                <!-- AI Insights card -->
                <div class="cm_card cm_card_ai">
                    <div class="cm_card_head">
                        <div class="cm_ai_label">
                            <span class="cm_ai_dot">●</span>
                            AI
                        </div>
                        <h3 class="cm_card_title">Smart Insights</h3>
                        <span class="cm_card_sub">Contract portfolio analysis</span>
                    </div>
                    <div class="cm_card_body">
                        <t t-if="state.data.insights.length === 0">
                            <div class="cm_empty">
                                <i class="fa fa-lightbulb-o cm_empty_ico"/>
                                <span>No insights yet — add more contracts to see AI analysis.</span>
                            </div>
                        </t>
                        <t t-foreach="state.data.insights" t-as="ins" t-key="ins_index">
                            <div t-attf-class="cm_insight {{ insightClass(ins.type) }}">
                                <div class="cm_ins_icon_wrap">
                                    <i t-attf-class="fa {{ ins.icon }}"/>
                                </div>
                                <div class="cm_ins_text">
                                    <strong class="cm_ins_title" t-esc="ins.title"/>
                                    <p class="cm_ins_body" t-esc="ins.body"/>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- Monthly Trend chart -->
                <div class="cm_card">
                    <div class="cm_card_head">
                        <div class="cm_card_ico cm_ico_blue">
                            <i class="fa fa-line-chart"/>
                        </div>
                        <div class="cm_card_head_text">
                            <h3 class="cm_card_title">Monthly Activity</h3>
                            <span class="cm_card_sub">Contracts started · last 6 months</span>
                        </div>
                    </div>
                    <div class="cm_card_body">
                        <t t-foreach="state.data.monthly_trend" t-as="m" t-key="m.label">
                            <div class="cm_bar_row">
                                <span class="cm_bar_lbl" t-esc="m.label"/>
                                <div class="cm_bar_track">
                                    <div t-attf-class="cm_bar_fill cm_bar_blue"
                                         t-attf-style="width:{{ barPct(m.count, state.data.monthly_trend) }}%"/>
                                </div>
                                <span class="cm_bar_val" t-esc="m.count"/>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- Language distribution -->
                <div class="cm_card">
                    <div class="cm_card_head">
                        <div class="cm_card_ico cm_ico_teal">
                            <i class="fa fa-globe"/>
                        </div>
                        <div class="cm_card_head_text">
                            <h3 class="cm_card_title">Language Distribution</h3>
                            <span class="cm_card_sub">Contracts by language</span>
                        </div>
                    </div>
                    <div class="cm_card_body cm_lang_grid">
                        <t t-if="state.data.lang_distribution.length === 0">
                            <span class="cm_empty">No data yet.</span>
                        </t>
                        <t t-foreach="state.data.lang_distribution" t-as="l" t-key="l.lang">
                            <div class="cm_lang_tile">
                                <span class="cm_lang_num" t-esc="l.count"/>
                                <span class="cm_lang_lbl" t-esc="l.label"/>
                            </div>
                        </t>
                    </div>
                </div>

            </div><!-- /col left -->

            <!-- ════════ RIGHT COLUMN ════════ -->
            <div class="cm_col">

                <!-- Contract Type Distribution -->
                <div class="cm_card">
                    <div class="cm_card_head">
                        <div class="cm_card_ico cm_ico_purple">
                            <i class="fa fa-bar-chart"/>
                        </div>
                        <div class="cm_card_head_text">
                            <h3 class="cm_card_title">By Contract Type</h3>
                            <span class="cm_card_sub">Distribution across all contracts</span>
                        </div>
                    </div>
                    <div class="cm_card_body">
                        <t t-if="state.data.type_distribution.length === 0">
                            <div class="cm_empty">
                                <i class="fa fa-inbox cm_empty_ico"/>
                                <span>No contracts yet.</span>
                            </div>
                        </t>
                        <t t-foreach="state.data.type_distribution" t-as="item" t-key="item.type">
                            <div class="cm_bar_row">
                                <span class="cm_bar_lbl" t-esc="item.label"/>
                                <div class="cm_bar_track">
                                    <div t-attf-class="cm_bar_fill {{ barColor(item_index) }}"
                                         t-attf-style="width:{{ barPct(item.count, state.data.type_distribution) }}%"/>
                                </div>
                                <span class="cm_bar_val" t-esc="item.count"/>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- Expiring contracts alert -->
                <div class="cm_card cm_card_warn"
                     t-if="state.data.expiring_contracts.length > 0">
                    <div class="cm_card_head">
                        <div class="cm_card_ico cm_ico_amber">
                            <i class="fa fa-exclamation-triangle"/>
                        </div>
                        <div class="cm_card_head_text">
                            <h3 class="cm_card_title">Expiring Within 30 Days</h3>
                        </div>
                        <span t-attf-class="cm_count_badge cm_count_warn"
                              t-esc="state.data.expiring_contracts.length"/>
                    </div>
                    <div class="cm_card_body cm_nop">
                        <table class="cm_tbl">
                            <thead>
                                <tr>
                                    <th><i class="fa fa-file-text-o me-1"/>Contract</th>
                                    <th><i class="fa fa-user me-1"/>Customer</th>
                                    <th><i class="fa fa-calendar me-1"/>Expires</th>
                                    <th><i class="fa fa-clock-o me-1"/>Days</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="state.data.expiring_contracts"
                                   t-as="c" t-key="c.id">
                                    <tr class="cm_tbl_row"
                                        t-on-click="() => this.openContract(c.id)">
                                        <td>
                                            <span class="cm_ref" t-esc="c.reference"/>
                                            <span class="cm_name" t-esc="c.name"/>
                                        </td>
                                        <td t-esc="c.partner"/>
                                        <td t-esc="c.date_end"/>
                                        <td>
                                            <span t-attf-class="{{ daysClass(c.days_left) }}"
                                                  t-esc="c.days_left + 'd'"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Recent contracts -->
                <div class="cm_card">
                    <div class="cm_card_head">
                        <div class="cm_card_ico cm_ico_indigo">
                            <i class="fa fa-history"/>
                        </div>
                        <div class="cm_card_head_text">
                            <h3 class="cm_card_title">Recent Contracts</h3>
                            <span class="cm_card_sub">Latest active &amp; draft</span>
                        </div>
                    </div>
                    <div class="cm_card_body cm_nop">
                        <t t-if="state.data.recent_contracts.length === 0">
                            <div class="cm_empty cm_pad">
                                <i class="fa fa-folder-open-o cm_empty_ico"/>
                                <span>No contracts yet.</span>
                            </div>
                        </t>
                        <table class="cm_tbl" t-if="state.data.recent_contracts.length > 0">
                            <thead>
                                <tr>
                                    <th>Ref</th>
                                    <th>Name</th>
                                    <th>Customer</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="state.data.recent_contracts"
                                   t-as="c" t-key="c.id">
                                    <tr class="cm_tbl_row"
                                        t-on-click="() => this.openContract(c.id)">
                                        <td><span class="cm_ref" t-esc="c.reference"/></td>
                                        <td class="cm_name" t-esc="c.name"/>
                                        <td t-esc="c.partner"/>
                                        <td>
                                            <span t-attf-class="cm_badge {{ stateClass(c.state) }}"
                                                  t-esc="c.state"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div><!-- /col right -->

        </div><!-- /grid -->

    </t><!-- /main -->

</div><!-- /cm_dash -->
</t>

</templates>
