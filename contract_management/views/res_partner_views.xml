<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Extend res.partner form to show a smart button linking to all contracts
        where this partner is the customer.
    -->
    <record id="view_partner_contract_button" model="ir.ui.view">
        <field name="name">res.partner.contract.button</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="%(contract_management.action_contract_contract)d"
                        type="action"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        context="{'search_default_partner_id': active_id, 'default_partner_id': active_id}"
                        domain="[('partner_id', 'child_of', active_id)]">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Contracts</span>
                    </div>
                </button>
            </div>
        </field>
    </record>

</odoo>
