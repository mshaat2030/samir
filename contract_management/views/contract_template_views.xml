<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════
         Contract Template — Form View
         ═══════════════════════════════════════════════════════════════ -->
    <record id="view_contract_template_form" model="ir.ui.view">
        <field name="name">contract.template.form</field>
        <field name="model">contract.template</field>
        <field name="arch" type="xml">
            <form string="Contract Template">
                <header>
                    <button name="action_create_contract"
                            string="Create Contract"
                            type="object"
                            class="btn-primary"
                            invisible="clause_count == 0"/>
                    <button name="action_duplicate_template"
                            string="Duplicate"
                            type="object"/>
                </header>

                <sheet>
                    <!-- Smart Buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_contracts"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-text-o">
                            <field name="contract_count" widget="statinfo" string="Contracts"/>
                        </button>
                        <button type="object"
                                name="action_view_contracts"
                                class="oe_stat_button"
                                icon="fa-list-ol">
                            <field name="clause_count" widget="statinfo" string="Clauses"/>
                        </button>
                    </div>

                    <widget name="web_ribbon"
                            text="Archived"
                            bg_color="text-bg-danger"
                            invisible="active"/>

                    <div class="oe_title">
                        <h1>
                            <field name="name"
                                   placeholder="Template Name…"
                                   required="1"/>
                        </h1>
                        <h4 class="text-muted">
                            <field name="reference" readonly="1"/>
                        </h4>
                    </div>

                    <group>
                        <group string="Classification">
                            <field name="contract_type" required="1"/>
                            <field name="language" required="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="user_id"/>
                        </group>
                        <group string="Statistics">
                            <field name="fixed_clause_count" readonly="1"/>
                            <field name="variable_clause_count" readonly="1"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- Clauses Tab -->
                        <page string="Clauses" name="clauses">
                            <field name="clause_ids"
                                   context="{'default_template_id': id}"
                                   nolabel="1">
                                <list editable="bottom"
                                      string="Template Clauses"
                                      class="cm_clause_list"
                                      default_order="sequence"
                                      decoration-info="clause_type == 'fixed'"
                                      decoration-success="clause_type == 'variable'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="clause_type"
                                           widget="badge"
                                           decoration-info="clause_type == 'fixed'"
                                           decoration-success="clause_type == 'variable'"
                                           required="1"/>
                                    <field name="title"
                                           string="Title (EN)"
                                           required="language != 'ar'"
                                           invisible="language == 'ar'"/>
                                    <field name="description"
                                           string="Content (EN)"
                                           widget="html"
                                           optional="show"
                                           invisible="language == 'ar'"/>
                                    <field name="title_ar"
                                           string="Title (AR)"
                                           required="language in ('bilingual', 'ar')"
                                           invisible="language not in ('bilingual', 'ar')"/>
                                    <field name="description_ar"
                                           string="Content (AR)"
                                           widget="html"
                                           optional="show"
                                           invisible="language not in ('bilingual', 'ar')"/>
                                    <field name="language" column_invisible="1"/>
                                    <field name="active" optional="hide"/>
                                </list>

                                <form string="Clause">
                                    <!-- ── Fixed clause banner ── -->
                                    <div class="cm_clause_fixed_banner o_form_no_print"
                                         invisible="clause_type != 'fixed'">
                                        <i class="fa fa-lock" title="Fixed"/>
                                        <span>
                                            <strong>Fixed Clause</strong> —
                                            body will be read-only on all contracts using this template.
                                        </span>
                                    </div>
                                    <!-- ── Variable clause banner ── -->
                                    <div class="cm_clause_variable_banner o_form_no_print"
                                         invisible="clause_type != 'variable'">
                                        <i class="fa fa-pencil" title="Variable"/>
                                        <span>
                                            <strong>Variable Clause</strong> —
                                            body can be tailored for each contract.
                                        </span>
                                    </div>

                                    <group>
                                        <group string="English"
                                               invisible="language == 'ar'">
                                            <field name="sequence"/>
                                            <field name="clause_type" required="1"/>
                                            <field name="title"
                                                   string="Title (EN)"
                                                   required="language != 'ar'"
                                                   placeholder="Clause heading…"/>
                                        </group>
                                        <group string="Arabic"
                                               invisible="language not in ('bilingual', 'ar')">
                                            <field name="sequence"
                                                   invisible="language != 'ar'"/>
                                            <field name="clause_type" required="1"
                                                   invisible="language != 'ar'"/>
                                            <field name="title_ar"
                                                   string="Title (AR)"
                                                   required="language in ('bilingual', 'ar')"
                                                   placeholder="عنوان البند…"/>
                                            <field name="language" invisible="1"/>
                                        </group>
                                    </group>

                                    <group string="Body (English)"
                                           invisible="language == 'ar'">
                                        <field name="description"
                                               nolabel="1"
                                               options="{'resizable': true}"
                                               placeholder="Enter clause body text…"/>
                                    </group>
                                    <group string="Body (Arabic — RTL)"
                                           invisible="language not in ('bilingual', 'ar')">
                                        <field name="description_ar"
                                               nolabel="1"
                                               style="direction: rtl; text-align: right;"
                                               options="{'resizable': true}"
                                               placeholder="أدخل نص البند هنا…"/>
                                    </group>

                                    <field name="clause_type" invisible="1"/>
                                </form>
                            </field>
                        </page>

                        <!-- Description Tab -->
                        <page string="Description / Purpose" name="description">
                            <field name="description"
                                   nolabel="1"
                                   placeholder="Describe the purpose and usage of this template…"/>
                        </page>

                        <!-- Internal Notes -->
                        <page string="Internal Notes" name="notes">
                            <field name="internal_note"
                                   nolabel="1"
                                   placeholder="Internal notes (not visible on PDF)…"/>
                        </page>
                    </notebook>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         Contract Template — List View
         ═══════════════════════════════════════════════════════════════ -->
    <record id="view_contract_template_list" model="ir.ui.view">
        <field name="name">contract.template.list</field>
        <field name="model">contract.template</field>
        <field name="arch" type="xml">
            <list string="Contract Templates" decoration-muted="not active">
                <field name="reference" string="Ref" optional="show"/>
                <field name="name"/>
                <field name="contract_type"/>
                <field name="language"/>
                <field name="clause_count" string="Clauses" optional="show"/>
                <field name="contract_count" string="Contracts" optional="show"/>
                <field name="user_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         Contract Template — Kanban View
         ═══════════════════════════════════════════════════════════════ -->
    <record id="view_contract_template_kanban" model="ir.ui.view">
        <field name="name">contract.template.kanban</field>
        <field name="model">contract.template</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="name"/>
                <field name="contract_type"/>
                <field name="language"/>
                <field name="clause_count"/>
                <field name="contract_count"/>
                <field name="active"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top mb-0">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <span t-attf-class="badge rounded-pill
                                    #{record.language.raw_value == 'bilingual' ? 'text-bg-info' : 'text-bg-secondary'}">
                                    <field name="language"/>
                                </span>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="contract_type"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left text-muted">
                                    <i class="fa fa-list-ol me-1" title="Clauses"/>
                                    <field name="clause_count"/> clauses
                                </div>
                                <div class="oe_kanban_bottom_right text-muted">
                                    <i class="fa fa-file-text-o me-1" title="Contracts"/>
                                    <field name="contract_count"/> contracts
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         Contract Template — Search View
         ═══════════════════════════════════════════════════════════════ -->
    <record id="view_contract_template_search" model="ir.ui.view">
        <field name="name">contract.template.search</field>
        <field name="model">contract.template</field>
        <field name="arch" type="xml">
            <search string="Search Templates">
                <field name="name" string="Template Name"/>
                <field name="reference"/>
                <field name="user_id"/>
                <separator/>
                <filter name="english" string="English Only"
                        domain="[('language', '=', 'en')]"/>
                <filter name="arabic_only" string="Arabic Only"
                        domain="[('language', '=', 'ar')]"/>
                <filter name="bilingual" string="Bilingual"
                        domain="[('language', '=', 'bilingual')]"/>
                <separator/>
                <filter name="archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_type" string="Contract Type"
                            context="{'group_by': 'contract_type'}"/>
                    <filter name="group_language" string="Language"
                            context="{'group_by': 'language'}"/>
                    <filter name="group_user" string="Responsible"
                            context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
