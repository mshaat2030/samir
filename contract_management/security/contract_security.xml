<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Odoo 19 res.groups only accepts `name` and `implied_ids` in XML data.
        `category_id` and `users` were removed as writable XML fields.

        Group hierarchy (each group inherits everything below it):
          group_contract_user   ← base.group_user
          group_contract_manager ← group_contract_user
          group_contract_admin   ← group_contract_manager

        Admin/root users gain access by being members of base.group_system,
        which bypasses record rules automatically in Odoo 19.
    -->

    <!-- ═══════════════════════════════════════════════════════════════
         Security Groups
         ═══════════════════════════════════════════════════════════════ -->

    <record id="group_contract_user" model="res.groups">
        <field name="name">Contract Management / User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_contract_manager" model="res.groups">
        <field name="name">Contract Management / Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_contract_user'))]"/>
    </record>

    <record id="group_contract_admin" model="res.groups">
        <field name="name">Contract Management / Administrator</field>
        <field name="implied_ids" eval="[(4, ref('group_contract_manager'))]"/>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         Record Rules — contract.contract
         ═══════════════════════════════════════════════════════════════ -->

    <record id="rule_contract_user_company" model="ir.rule">
        <field name="name">Contract: own company only (users)</field>
        <field name="model_id" ref="model_contract_contract"/>
        <field name="groups" eval="[(4, ref('group_contract_user'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_contract_admin_all" model="ir.rule">
        <field name="name">Contract: all companies (admins)</field>
        <field name="model_id" ref="model_contract_contract"/>
        <field name="groups" eval="[(4, ref('group_contract_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         Record Rules — contract.template
         ═══════════════════════════════════════════════════════════════ -->

    <record id="rule_template_user_read" model="ir.rule">
        <field name="name">Template: company-scoped read (users)</field>
        <field name="model_id" ref="model_contract_template"/>
        <field name="groups" eval="[(4, ref('group_contract_user'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_template_manager_write" model="ir.rule">
        <field name="name">Template: company-scoped write (managers)</field>
        <field name="model_id" ref="model_contract_template"/>
        <field name="groups" eval="[(4, ref('group_contract_manager'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_template_admin_all" model="ir.rule">
        <field name="name">Template: unrestricted (admins)</field>
        <field name="model_id" ref="model_contract_template"/>
        <field name="groups" eval="[(4, ref('group_contract_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>
